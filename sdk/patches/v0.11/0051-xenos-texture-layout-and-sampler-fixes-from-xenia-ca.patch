@@ -406,24 +428,31 @@ u32 GetTiledAddressUpperBound3D(u32 right, u32 bottom, u32 back, u32 pitch, u32
   if (!right || !bottom || !back) {
     return 0;
   }
-  u32 upper_bound = static_cast<u32>(
-      GetTiledOffset3D(static_cast<i32>((right - 1) & ~(xenos::kTextureTileWidthHeight - 1)),
-                       static_cast<i32>((bottom - 1) & ~(xenos::kTextureTileWidthHeight - 1)),
-                       static_cast<i32>((back - 1) & ~(xenos::kTextureTileDepth - 1)), pitch,
-                       height, bytes_per_block_log2));
+  // The highest block address in the last 32-row, 4-slice portion (Xenia Canary c332733: the
+  // closed form missed a bank 0x800 past it, or took 0x880 and a page too many). Addresses grow
+  // within aligned runs of 8 blocks along X, but bank and pipe selection can put an earlier run
+  // higher, so every run's last block is checked; with 1 byte per block two 32x16x4 macro tiles
+  // share a page, so both halves of the portion are searched; wider than the pitch, a block's
+  // (x, y) becomes (x % pitch, y + 16 * (x / pitch)), so every row is.
   u32 pitch_aligned = rex::RoundUpPow2(pitch, xenos::kTextureTileWidthHeight);
-  switch (bytes_per_block_log2) {
-    case 0:
-      // 64x32x8 portions address independently.
-      upper_bound +=
-          ((pitch_aligned >> 6) << 12) + 0xC00 + ((pitch_aligned & (1 << 5)) << (10 - 5));
-      break;
-    default:
-      // 32x32x8 portions address independently.
-      upper_bound += ((pitch_aligned << (12 - 5 - 1)) + (0x1000 >> 1)) << bytes_per_block_log2;
-      break;
+  u32 y_first = right > pitch_aligned ? 0 : (bottom - 1) & ~(xenos::kTextureTileWidthHeight - 1);
+  u32 z_first = (back - 1) & ~(xenos::kTextureTileDepth - 1);
+  i64 upper_bound = 0;
+  for (u32 z = z_first; z < back; ++z) {
+    for (u32 y = y_first; y < bottom; ++y) {
+      for (u32 x = 7;; x += 8) {
+        u32 x_last = std::min(x, right - 1);
+        upper_bound = std::max(
+            upper_bound, static_cast<i64>(GetTiledOffset3D(
+                             static_cast<i32>(x_last), static_cast<i32>(y), static_cast<i32>(z),
+                             pitch, height, bytes_per_block_log2)));
+        if (x_last == right - 1) {
+          break;
+        }
+      }
+    }
   }
-  return upper_bound;
+  return static_cast<u32>(upper_bound) + (static_cast<u32>(1) << bytes_per_block_log2);
