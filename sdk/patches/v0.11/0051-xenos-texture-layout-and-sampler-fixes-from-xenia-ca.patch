 u8 SwizzleSigns(const xenos::TextureFetch& fetch) {
diff --git a/tests/unit/gpu/texture_layout_test.cpp b/tests/unit/gpu/texture_layout_test.cpp
index de6327c0..5e1daa7d 100644
--- a/tests/unit/gpu/texture_layout_test.cpp
+++ b/tests/unit/gpu/texture_layout_test.cpp
@@ -10,6 +10,9 @@
 
 #include "rex_test.h"
 
+#include <algorithm>
+#include <cstdint>
+
 #include <rex/types.h>
 #include <rex/xenos/texture.h>
 #include <rex/xenos/fetch.h>
@@ -43,7 +46,39 @@ REX_TEST_CASE("The 3D lower bound moves to the next tile at the tile depth", "[g
   constexpr rex::u32 kTilesPerSlab = (kPitch / rex::xenos::kTextureTileWidthHeight) *
                                      (kHeight / rex::xenos::kTextureTileWidthHeight);
   constexpr rex::u32 kSlabBytes = kTilesPerSlab * (kTileBlocks << kBytesPerBlockLog2);
-  constexpr rex::u32 kBankSwizzleBytes = 0x880;
   CHECK(first == 0);
-  CHECK(next == kSlabBytes + kBankSwizzleBytes);
+  // In odd groups of 4 layers the bank swap stores Y = 8 first, at the slab's start (Xenia Canary
+  // c9c8e48): (0, 0, 4) itself is 0x880 further.
+  CHECK(next == kSlabBytes);
+}
+
+// The bounds against every block of a region, by brute force (Xenia Canary c9c8e48, c332733).
+static void CheckBounds3D(rex::u32 right, rex::u32 bottom, rex::u32 back, rex::u32 pitch,
+                          rex::u32 height, rex::u32 bpb_log2) {
+  rex::i64 lowest = INT64_MAX, highest = -1;
+  for (rex::u32 z = 0; z < back; ++z) {
+    for (rex::u32 y = 0; y < bottom; ++y) {
+      for (rex::u32 x = 0; x < right; ++x) {
+        const rex::i64 a = rex::xenos::GetTiledOffset3D(rex::i32(x), rex::i32(y), rex::i32(z), pitch,
+                                                        height, bpb_log2);
+        lowest = std::min(lowest, a);
+        highest = std::max(highest, a);
+      }
+    }
+  }
+  CHECK(rex::i64(rex::xenos::GetTiledAddressLowerBound3D(0, 0, 0, pitch, height, bpb_log2)) <=
+        lowest);
+  CHECK(rex::i64(rex::xenos::GetTiledAddressUpperBound3D(right, bottom, back, pitch, height,
+                                                         bpb_log2)) ==
+        highest + (rex::i64(1) << bpb_log2));
+}
+
+REX_TEST_CASE("The 3D upper bound is the highest block's end", "[gpu][texture]") {
+  for (rex::u32 bpb_log2 = 0; bpb_log2 <= 3; ++bpb_log2) {
+    CheckBounds3D(32, 32, 4, 32, 32, bpb_log2);
+    CheckBounds3D(64, 32, 8, 64, 32, bpb_log2);
+    CheckBounds3D(96, 40, 6, 96, 64, bpb_log2);
+    CheckBounds3D(40, 33, 5, 96, 64, bpb_log2);
+    CheckBounds3D(17, 9, 3, 32, 32, bpb_log2);
+  }
 }
