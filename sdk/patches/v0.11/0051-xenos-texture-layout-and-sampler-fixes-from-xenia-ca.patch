@@ -152,11 +152,16 @@ inline u32 GetTiledAddressLowerBound2D(u32 left, u32 top, u32 pitch, u32 bytes_p
  */
 inline u32 GetTiledAddressLowerBound3D(u32 left, u32 top, u32 front, u32 pitch, u32 height,
                                        u32 bytes_per_block_log2) {
-  return static_cast<u32>(
-      GetTiledOffset3D(static_cast<i32>(left & ~(xenos::kTextureTileWidthHeight - 1)),
-                       static_cast<i32>(top & ~(xenos::kTextureTileWidthHeight - 1)),
-                       static_cast<i32>(front & ~(xenos::kTextureTileDepth - 1)), pitch, height,
-                       bytes_per_block_log2));
+  // In odd groups of 4 slices the bank swap stores Y = 8 first, not Y = 0 (Xenia Canary c9c8e48).
+  u32 front_aligned = front & ~(xenos::kTextureTileDepth - 1);
+  u32 top_aligned = top & ~(xenos::kTextureTileWidthHeight - 1);
+  if (front_aligned & xenos::kTextureTileDepth) {
+    top_aligned += 8;
+  }
+  return static_cast<u32>(GetTiledOffset3D(
+      static_cast<i32>(left & ~(xenos::kTextureTileWidthHeight - 1)),
+      static_cast<i32>(top_aligned), static_cast<i32>(front_aligned), pitch, height,
+      bytes_per_block_log2));
 }
 
