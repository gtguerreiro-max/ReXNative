From eda83f7a6dd411140f223fc24b1b61c6103b0767 Mon Sep 17 00:00:00 2001
From: gtguerreiro-max <295622337+gtguerreiro-max@users.noreply.github.com>
Date: Thu, 19 Nov 2026 14:44:20 +0000
Subject: [PATCH] xam: XamSwapDisc sets the completion event for the running
 disc

A multi-disc title's disc library asks for a disc and waits on the event; the
stub never set it, so Deus Ex: Human Revolution Director's Cut waited on its
"insert disc 1" screen for ever as a new game started on disc 1. The running
disc (the execution info's disc_number) sets the event at once, as Xenia
canary does; another disc is logged and the title keeps asking for it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/xam/xam_info.cpp | 32 +++++++++++++++++++++++++++++---
 1 file changed, 29 insertions(+), 3 deletions(-)

diff --git a/src/xam/xam_info.cpp b/src/xam/xam_info.cpp
index 56af9fdc..616eecd8 100644
--- a/src/xam/xam_info.cpp
+++ b/src/xam/xam_info.cpp
@@ -41,6 +41,7 @@
 #include <format>
 #include <rex/kernel/thread_state.h>
 #include <rex/kernel/types/xex.h>
+#include <rex/kernel/object/event_object.h>
 #include <rex/kernel/object/object_table.h>
 #include "xam/xam_bodies.h"
 
@@ -410,9 +411,34 @@ u32 XamLoaderGetDvdTrayState_entry(MappedU32 out_state) {
   return kernel::X_STATUS_SUCCESS;
 }
 
-u32 XamSwapDisc_entry(u32 disc_number) {
-  REX_XAM_STUB("XamSwapDisc({})", static_cast<u32>(disc_number));
-  return kernel::X_STATUS_SUCCESS;
+// XamSwapDisc(disc, completion event, error message): a multi-disc title's disc library asks for
+// a disc, shows its own "insert disc" screen and waits on the event (a KEVENT the title got with
+// ObReferenceObjectByHandle). The running disc (the execution info's disc_number) is already in,
+// so the event is set at once, as Xenia canary does: Deus Ex: Human Revolution Director's Cut asks
+// for disc 1 as a new game starts and waited on its "insert disc 1" screen for ever. Another disc
+// can't be inserted here: the event stays clear and the title keeps asking for it.
+u32 XamSwapDisc_entry(u32 disc_number, u32 completion_event, [[maybe_unused]] u32 error_message) {
+  auto module = CurrentTitle().objects.Get<kernel::ILoadedModule>(
+      CurrentTitle().modules.GetExecutable().value_or(0));
+  kernel::XEXOptExecutionInfo* info = nullptr;
+  if (module) {
+    module->OptHeader(kernel::kXEXHeaderExecutionInfo, &info);
+  }
+  const u32 running = info && info->disc_number ? info->disc_number : 1;
+  const u32 count = info && info->disc_count ? info->disc_count : 1;
+  if (running > count) {
+    return kernel::X_ERROR_INVALID_PARAMETER;
+  }
+  if (disc_number == running) {
+    REXXAM_INFO("XamSwapDisc({}): disc {} of {} is running", disc_number, running, count);
+    if (auto event = CurrentTitle().objects.Resolve<kernel::IGuestEvent>(completion_event)) {
+      event->Set();
+    }
+    return kernel::X_ERROR_SUCCESS;
+  }
+  REXXAM_WARN("XamSwapDisc({}): disc {} of {} is running; another disc can't be inserted",
+              disc_number, running, count);
+  return kernel::X_ERROR_SUCCESS;
 }
 
 }  // namespace xam
