From 1b0332f24271898d3c8fffccd1c2bd9cf95ca243 Mon Sep 17 00:00:00 2001
From: gtguerreiro-max <295622337+gtguerreiro-max@users.noreply.github.com>
Date: Wed, 25 Nov 2026 00:52:08 +0000
Subject: [PATCH 59/60] kernel: XFileSectorInformation's stub said once

NtQueryInformationFile gives a sector made from the path's hash; a game
asks it of every file it streams (Forza Horizon about twice a second,
1291 log lines in ten minutes), each time logged as unimplemented. The
warning now comes once per run.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/kernel/xboxkrnl/xboxkrnl_io_info.cpp | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/src/kernel/xboxkrnl/xboxkrnl_io_info.cpp b/src/kernel/xboxkrnl/xboxkrnl_io_info.cpp
index 20a8c53b..80b888d8 100644
--- a/src/kernel/xboxkrnl/xboxkrnl_io_info.cpp
+++ b/src/kernel/xboxkrnl/xboxkrnl_io_info.cpp
@@ -9,6 +9,8 @@
  * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
  */
 
+#include <atomic>
+
 #include <rex/hash.h>
 #include <rex/filesystem/file_stat.h>
 #include <rex/filesystem/file_system.h>
@@ -92,7 +94,12 @@ u32 NtQueryInformationFile_entry(u32 file_handle, GuestPtrT<X_IO_STATUS_BLOCK> i
       break;
     }
     case XFileSectorInformation: {
-      REX_KERNEL_STUB("XFileSectorInformation");
+      // A sector made up from the path's hash. A game asks it of every file it streams (Forza
+      // Horizon about twice a second, 1291 lines in ten minutes' log): said once.
+      static std::atomic<bool> said{false};
+      if (!said.exchange(true, std::memory_order_relaxed)) {
+        REX_KERNEL_STUB("XFileSectorInformation (a sector from the path's hash; said once)");
+      }
       auto info = info_ptr.As<u32*>();
       size_t fname_hash = rex::hash_combine(82589933LL, file->file->GetInfo().path);
       *info = static_cast<u32>(fname_hash ^ (fname_hash >> 32));
-- 
