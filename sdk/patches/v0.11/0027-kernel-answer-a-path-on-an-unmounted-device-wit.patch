From c516574192d8aa840ac3e3e162c180048d1ae9a6 Mon Sep 17 00:00:00 2001
From: gtguerreiro-max <295622337+gtguerreiro-max@users.noreply.github.com>
Date: Mon, 16 Nov 2026 18:48:11 +0000
Subject: [PATCH 27/30] 
 0015-kernel-answer-a-path-on-an-unmounted-device-with-NO_SUCH_FILE

FileSystem::OpenFrom turned a path whose device has no mount (kNoMount) into a missing file
(kNotFound), which NtCreateFile answers with OBJECT_NAME_NOT_FOUND. The XDK's cache partition
code linked into titles opens cache:\ before anything mounts it, and handles the
X_STATUS_NO_SUCH_FILE Xenia and ReXGlue v0.10 answered; on OBJECT_NAME_NOT_FOUND Bionic Commando
Rearmed went on with a null pointer and crashed at start-up (a read of guest address 0x58).
OpenFrom now keeps kNoMount, and NtCreateFile answers it with X_STATUS_NO_SUCH_FILE.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/filesystem/file_system.cpp      | 4 ++++
 src/kernel/xboxkrnl/xboxkrnl_io.cpp | 7 +++++++
 2 files changed, 11 insertions(+)

diff --git a/src/filesystem/file_system.cpp b/src/filesystem/file_system.cpp
index 01e2b072..dd9227f7 100644
--- a/src/filesystem/file_system.cpp
+++ b/src/filesystem/file_system.cpp
@@ -171,6 +171,10 @@ Result<Opened> FileSystem::OpenFrom(Node* root, std::string_view requested,
     }
     if (auto resolved = ResolveNode(path)) {
       node = *resolved;
+    } else if (CodeOf(resolved.error()) == FileSystemError::kNoMount) {
+      // A device nothing is mounted at (cache: before a title mounts it) stays kNoMount, not a
+      // missing file: the kernel answers it as Xenia does (NtCreateFile).
+      return Err<Opened>(resolved.error());
     }
   }
 
diff --git a/src/kernel/xboxkrnl/xboxkrnl_io.cpp b/src/kernel/xboxkrnl/xboxkrnl_io.cpp
index 4f5a7753..1df88257 100644
--- a/src/kernel/xboxkrnl/xboxkrnl_io.cpp
+++ b/src/kernel/xboxkrnl/xboxkrnl_io.cpp
@@ -154,6 +154,13 @@ u32 NtCreateFile_entry(MappedU32 handle_out, u32 desired_access,
     if (filesystem::CodeOf(opened.error()) == filesystem::FileSystemError::kExists) {
       file_action = filesystem::OpenAction::kExists;
     }
+    // A path on a device with no mount: X_STATUS_NO_SUCH_FILE, as Xenia and ReXGlue v0.10 answer.
+    // The XDK's cache partition code linked into titles opens cache:\ before anything mounts it
+    // and handles that status; on OBJECT_NAME_NOT_FOUND Bionic Commando Rearmed went on with a
+    // null pointer and crashed at start-up.
+    if (filesystem::CodeOf(opened.error()) == filesystem::FileSystemError::kNoMount) {
+      result = X_STATUS_NO_SUCH_FILE;
+    }
   }
   X_HANDLE handle = kXInvalidHandleValue;
   if (XSUCCEEDED(result)) {
