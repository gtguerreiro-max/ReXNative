From: gtguerreiro-max <295622337+gtguerreiro-max@users.noreply.github.com>
Date: Mon, 16 Nov 2026 17:21:45 +0000
Subject: [PATCH 20/30] 
 0009-codegen-name-the-second-copy-of-a-millicode-helper-run-apart

---
 src/codegen/phase_register.cpp | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/src/codegen/phase_register.cpp b/src/codegen/phase_register.cpp
index 95e8c21c..a033ffed 100644
--- a/src/codegen/phase_register.cpp
+++ b/src/codegen/phase_register.cpp
@@ -678,14 +678,23 @@ u32 FindRestoreHelper(const AnalysisState& state, const MillicodeEntry& entry) {
         import_count, resolved_count, module_import_count, unresolved_count, variable_count);
   }
 
-  for (const auto& run : state.millicode_runs) {
+  for (size_t run_index = 0; run_index < state.millicode_runs.size(); ++run_index) {
+    const auto& run = state.millicode_runs[run_index];
     const u32 tail_bytes = static_cast<u32>(GetTailWords(run.type).size()) * kWordBytes;
+    // A second copy of a helper run keeps the names apart with its address.
+    const bool copy = std::any_of(state.millicode_runs.begin(),
+                                  state.millicode_runs.begin() + run_index,
+                                  [&](const MillicodeRun& other) {
+                                    return IsSameRunClass(other, run.type, run.first);
+                                  });
     for (u32 i = 0; i < run.count; ++i) {
       const u32 addr = run.head + i * run.stride;
       const u32 reg = run.first + i;
       graph.AddFunction(addr, (run.count - i) * run.stride + tail_bytes, FunctionAuthority::kHelper,
                         true);
-      graph.SetFunctionName(addr, std::format("{}{}", GetMillicodePrefix(run.type), reg));
+      graph.SetFunctionName(addr, copy ? std::format("{}{}_{:08X}", GetMillicodePrefix(run.type),
+                                                     reg, addr)
+                                       : std::format("{}{}", GetMillicodePrefix(run.type), reg));
       graph.SetFunctionMillicode(addr, MillicodeEntry{run.type, reg});
     }
   }
