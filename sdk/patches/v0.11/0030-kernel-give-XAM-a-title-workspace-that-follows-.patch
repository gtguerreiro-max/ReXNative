From 11eab72066bb07802c83a24de79662702a4df91e Mon Sep 17 00:00:00 2001
From: gtguerreiro-max <295622337+gtguerreiro-max@users.noreply.github.com>
Date: Mon, 16 Nov 2026 19:53:31 +0000
Subject: [PATCH] 
 0017-kernel-give-XAM-a-title-workspace-that-follows-the-current-heap

TitleState::Load hands XAM its kernel interfaces with the title workspace as a reference to the
WorkspaceHeap of the time. InitializeProcess then makes a new heap of the size the executable's
TitleWorkspaceSize header asks for, and the reference XAM kept pointed to the destroyed one: a
title with that header crashed in XamAlloc on a call through freed memory (Brothers - A Tale of
Two Sons, with either renderer, at its first XAM allocation). TitleState now is the workspace XAM
gets, forwarding Allocate and Free to the heap it has at the time.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/kernel/title_state.cpp | 15 ++++++++++++++-
 src/kernel/title_state.h   | 14 +++++++++++++-
 2 files changed, 27 insertions(+), 2 deletions(-)

diff --git a/src/kernel/title_state.cpp b/src/kernel/title_state.cpp
index 0bf28bd4..a32b15ec 100644
--- a/src/kernel/title_state.cpp
+++ b/src/kernel/title_state.cpp
@@ -540,6 +540,19 @@ WorkspaceHeap& TitleState::GetWorkspace() {
   return *workspace_;
 }
 
+Result<u32> TitleState::Allocate(u32 size, bool zero) {
+  if (!workspace_) {
+    return Err<u32>(ErrorCategory::kRuntime, "the title has no workspace");
+  }
+  return workspace_->Allocate(size, zero);
+}
+
+void TitleState::Free(u32 address) {
+  if (workspace_) {
+    workspace_->Free(address);
+  }
+}
+
 IModuleRegistry& TitleState::GetModuleRegistry() {
   return *module_registry_;
 }
@@ -807,7 +820,7 @@ Result<void> TitleState::CreateXAM() {
           .exit = *this,
           .debug = *this,
           .heap = *memory_,
-          .workspace = *workspace_,
+          .workspace = *this,
           .file_system = *file_system_,
           .file_system_factory = *GetKernelServices()->file_system,
           .membase = memory_->GetMembase(),
diff --git a/src/kernel/title_state.h b/src/kernel/title_state.h
index b7655632..1777bb89 100644
--- a/src/kernel/title_state.h
+++ b/src/kernel/title_state.h
@@ -40,6 +40,7 @@
 #include <rex/filesystem/mount.h>
 #include <rex/filesystem/file_system.h>
 #include <rex/filesystem/xdbf.h>
+#include <rex/kernel/guest_allocator.h>
 #include <rex/kernel/guest_memory.h>
 #include <rex/kernel/title_runtime.h>
 #include <rex/kernel/kernel_settings.h>
@@ -107,7 +108,10 @@ namespace kernel {
  * public TitleRuntime forwards its calls here. The subsystem getters are valid between Load and
  * Unload.
  */
-class TitleState : public ITitleExit, public ITitleDebugOutput, public rex::NonCopyable {
+class TitleState : public ITitleExit,
+                   public ITitleDebugOutput,
+                   public ITitleWorkspace,
+                   public rex::NonCopyable {
  public:
   /**
    * Creates an unloaded state for a title image.
@@ -344,6 +348,14 @@ class TitleState : public ITitleExit, public ITitleDebugOutput, public rex::NonC
   /** Logs debug text the title printed, in the title category. */
   void WriteTitleDebugString(std::string_view text) override;
 
+  /**
+   * The title workspace as XAM uses it, forwarded to the current heap: InitializeProcess makes a
+   * new heap of the size the executable asks for after XAM took its interfaces, and a reference to
+   * the first heap would dangle (Brothers - A Tale of Two Sons crashed in XamAlloc).
+   */
+  [[nodiscard]] Result<u32> Allocate(u32 size, bool zero) override;
+  void Free(u32 address) override;
+
   bool IsTerminatingTitle() const { return terminating_title_.load(std::memory_order_acquire); }
 
   /**
