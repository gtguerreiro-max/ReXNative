+// A game's alertable Sleep(0) poll loop (Forza Horizon's thread 0x11: 13,900 a second) made an
+// alertable host yield each time, SleepEx(0, TRUE): under Wine a wineserver round trip, which
+// checks for user APCs. Those come with the park word's interrupt here (InterruptFastWait), so
+// the yield looks at the word and yields in the process.
+std::optional<rex::platform::SleepResult> KernelThread::ParkYield() {
+  constexpr u32 kParkInterrupt = 2;  // fast_sync.cpp's
+  if (!GetRuntimeSettings().fast_sleeps.Get() ||
+      !rex::platform::SleepOnWord(park_word_, 0, std::chrono::microseconds(0))) {
+    return std::nullopt;
+  }
+  if ((park_word_.load(std::memory_order_seq_cst) & kParkInterrupt) || HasWaitInterrupt()) {
+    park_word_.fetch_and(~kParkInterrupt, std::memory_order_seq_cst);
+    (void)rex::platform::AlertableSleep(std::chrono::microseconds(0));
+    return rex::platform::SleepResult::kAlerted;
+  }
+  rex::platform::MaybeYield();
+  return rex::platform::SleepResult::kSuccess;
+}
+
+// A game's Sleep(1) loop (Iron Brigade, Forza Horizon, Overlord II's network thread) took a
+// quarter of a core on the Steam Deck: each sleep armed a high resolution waitable timer and
+// waited on it alertably (wineserver objects under Wine, two round trips) and spun its last
+// 250 us. On the park word it is one futex sleep in the process, woken as a fast wait is.
+std::optional<rex::platform::SleepResult> KernelThread::ParkSleep(
+    std::chrono::microseconds duration) {
+  constexpr u32 kParkInterrupt = 2;  // fast_sync.cpp's
+  if (!GetRuntimeSettings().fast_sleeps.Get()) {
+    return std::nullopt;
+  }
+  const auto deadline = std::chrono::steady_clock::now() + duration;
+  // Clears an old signal bit (no object hands this thread one while it sleeps), keeps an interrupt.
+  park_word_.fetch_and(kParkInterrupt, std::memory_order_seq_cst);
+  for (;;) {
+    const u32 word = park_word_.load(std::memory_order_seq_cst);
+    if ((word & kParkInterrupt) || HasWaitInterrupt()) {
+      park_word_.fetch_and(~kParkInterrupt, std::memory_order_seq_cst);
+      // The request's host callback, which an alertable host sleep would have run.
+      (void)rex::platform::AlertableSleep(std::chrono::microseconds(0));
+      return rex::platform::SleepResult::kAlerted;
+    }
+    const auto left = std::chrono::duration_cast<std::chrono::microseconds>(
+        deadline - std::chrono::steady_clock::now());
+    if (left.count() <= 0) {
+      return rex::platform::SleepResult::kSuccess;
+    }
+    if (!rex::platform::SleepOnWord(park_word_, word, left)) {
+      return std::nullopt;  // not this platform: the caller's timer
+    }
+  }
+}
