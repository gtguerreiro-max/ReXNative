diff --git a/include/rex/platform/sync.h b/include/rex/platform/sync.h
index 119883c9..552530f6 100644
--- a/include/rex/platform/sync.h
+++ b/include/rex/platform/sync.h
@@ -38,6 +38,23 @@ namespace rex::platform {
 REX_API bool WaitOnWord(const std::atomic<u32>& word, u32 expected,
                         std::chrono::milliseconds timeout);
 
+/**
+ * Sleeps on the word for up to `duration`, to the microsecond, where the platform can with no
+ * system object: under Wine, RtlWaitOnAddress (a futex in the process; a waitable timer there is
+ * a wineserver object, two round trips a sleep). Elsewhere it returns false at once and the caller
+ * sleeps its own way (Windows rounds such a sleep up to its timer period). WakeOneOnWord and
+ * WakeAllOnWord end it early; it may also return early for no reason, as WaitOnWord.
+ *
+ * @param word The word to watch.
+ * @param expected The value the thread sleeps on.
+ * @param duration The longest sleep.
+ * @return False when the platform has no such sleep (nothing was done).
+ */
+REX_API bool SleepOnWord(const std::atomic<u32>& word, u32 expected,
+                         std::chrono::microseconds duration);
+/** SleepOnWord is there (code built against several SDKs looks for it). */
+#define REX_PLATFORM_HAS_SLEEP_ON_WORD 1
+
 /** Wakes one thread sleeping in WaitOnWord on the word. Costs no system call without a sleeper. */
 REX_API void WakeOneOnWord(std::atomic<u32>& word);
 
