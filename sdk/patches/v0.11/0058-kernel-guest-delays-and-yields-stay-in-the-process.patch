diff --git a/src/base/threading_win.cpp b/src/base/threading_win.cpp
index 8c473844..e2a90e9a 100644
--- a/src/base/threading_win.cpp
+++ b/src/base/threading_win.cpp
@@ -119,6 +119,42 @@ bool WaitOnWord(const std::atomic<u32>& word, u32 expected, std::chrono::millise
   return GetLastError() != ERROR_TIMEOUT;
 }
 
+namespace {
+
+// ntdll's RtlWaitOnAddress, under Wine only (ntdll exports wine_get_version there): its timeout is
+// in 100 ns units and it waits on a futex in the process. On Windows it waits on the kernel's
+// timer, rounded up to the timer period (15.6 ms unless raised).
+using RtlWaitOnAddressFn = LONG(NTAPI*)(const void* address, const void* compare, SIZE_T size,
+                                        const LARGE_INTEGER* timeout);
+
+RtlWaitOnAddressFn WineWaitOnAddress() {
+  static const RtlWaitOnAddressFn fn = [] {
+    const HMODULE ntdll = GetModuleHandleW(L"ntdll.dll");
+    if (!ntdll || !GetProcAddress(ntdll, "wine_get_version")) {
+      return RtlWaitOnAddressFn{nullptr};
+    }
+    return reinterpret_cast<RtlWaitOnAddressFn>(GetProcAddress(ntdll, "RtlWaitOnAddress"));
+  }();
+  return fn;
+}
+
+}  // namespace
+
+bool SleepOnWord(const std::atomic<u32>& word, u32 expected, std::chrono::microseconds duration) {
+  const RtlWaitOnAddressFn wait = WineWaitOnAddress();
+  if (!wait) {
+    return false;
+  }
+  if (duration <= std::chrono::microseconds::zero()) {
+    return true;
+  }
+  LARGE_INTEGER timeout;
+  timeout.QuadPart = -static_cast<LONGLONG>(duration.count()) * 10;  // relative, 100 ns units
+  // NOLINTNEXTLINE(cppcoreguidelines-pro-type-const-cast): RtlWaitOnAddress only reads the word
+  (void)wait(const_cast<std::atomic<u32>*>(&word), &expected, sizeof(u32), &timeout);
+  return true;
+}
+
 void WakeOneOnWord(std::atomic<u32>& word) {
   ::WakeByAddressSingle(&word);
 }
