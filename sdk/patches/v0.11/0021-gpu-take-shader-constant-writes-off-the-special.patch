From 5792bfca0f349557d8f53c36e51dbdd7c8659653 Mon Sep 17 00:00:00 2001
From: shaurizard <contact@nyoom.engineering>
Date: Mon, 16 Nov 2026 17:52:00 +0000
Subject: [PATCH 21/30] 
 0010-gpu-take-shader-constant-writes-off-the-special-register-path

Shader constant writes are by far the most frequent register writes. They no longer go through
the register info lookup and the special register checks; PM4 type-0 runs go through the range
writer, which the D3D12 backend handles as one copy per constant block; and a write or range
write that leaves every value as it was returns before invalidating any binding. Ported to
ReXGlue v0.11 from pgr4-native's patch 0010 (v0.11 already had the range writer's copies).
---
 src/gpu/xenos/command_processor.cpp       | 22 +++++++++++++---
 src/gpu/xenos/d3d12/command_processor.cpp | 32 +++++++++++++++++++++++
 2 files changed, 50 insertions(+), 4 deletions(-)

diff --git a/src/gpu/xenos/command_processor.cpp b/src/gpu/xenos/command_processor.cpp
index 2bfadf23..2eec5e85 100644
--- a/src/gpu/xenos/command_processor.cpp
+++ b/src/gpu/xenos/command_processor.cpp
@@ -356,6 +356,16 @@ void CommandProcessor::WriteRegister(u32 index, u32 value) {
 
   // Volatile for the WAIT_REG_MEM loop.
   const_cast<volatile u32&>(regs.values[index]) = value;
+  // Shader constants, the most frequent writes by far, are plain storage with no side effects
+  // here; the backend tracks their bindings.
+  if ((index >= std::to_underlying(xenos::Register::SHADER_CONSTANT_000_X) &&
+       index <= std::to_underlying(xenos::Register::SHADER_CONSTANT_511_W)) ||
+      (index >= std::to_underlying(xenos::Register::SHADER_CONSTANT_BOOL_000_031) &&
+       index <= std::to_underlying(xenos::Register::SHADER_CONSTANT_LOOP_31)) ||
+      (index >= std::to_underlying(xenos::Register::SHADER_CONSTANT_FETCH_00_0) &&
+       index <= std::to_underlying(xenos::Register::SHADER_CONSTANT_FETCH_31_5))) {
+    return;
+  }
   if (!regs.GetRegisterInfo(index)) {
     REXGPU_WARN_ONCE(unknown_write_once_, index, "GPU: Write to unknown register ({:04X} = {:08X})",
                      index, value);
@@ -684,10 +694,14 @@ bool CommandProcessor::ExecutePacketType0(memory::RingBuffer* reader, u32 packet
 
   u32 base_index = (packet & 0x7FFF);
   u32 write_one_reg = (packet >> 15) & 0x1;
-  for (u32 m = 0; m < count; m++) {
-    u32 reg_data = reader->ReadAndSwap<u32>();
-    u32 target_index = write_one_reg ? base_index : base_index + m;
-    WriteRegister(target_index, reg_data);
+  if (write_one_reg) {
+    for (u32 m = 0; m < count; m++) {
+      WriteRegister(base_index, reader->ReadAndSwap<u32>());
+    }
+  } else {
+    // A sequential write goes through the range writer, which the backend can handle as one copy
+    // (most of these packets set runs of shader constants).
+    WriteRegisterRangeFromRing(reader, base_index, count);
   }
 
   return true;
diff --git a/src/gpu/xenos/d3d12/command_processor.cpp b/src/gpu/xenos/d3d12/command_processor.cpp
index be3c0d9e..3c75be01 100644
--- a/src/gpu/xenos/d3d12/command_processor.cpp
+++ b/src/gpu/xenos/d3d12/command_processor.cpp
@@ -1665,6 +1665,17 @@ void D3D12CommandProcessor::ShutdownContext() {
 }
 
 void D3D12CommandProcessor::WriteRegister(u32 index, u32 value) {
+  // Rewriting a shader constant with its current value changes no binding: keep the constant
+  // buffers, texture bindings and vertex buffer residency that depend on it.
+  if (((index >= std::to_underlying(xenos::Register::SHADER_CONSTANT_000_X) &&
+       index <= std::to_underlying(xenos::Register::SHADER_CONSTANT_511_W)) ||
+      (index >= std::to_underlying(xenos::Register::SHADER_CONSTANT_BOOL_000_031) &&
+       index <= std::to_underlying(xenos::Register::SHADER_CONSTANT_LOOP_31)) ||
+      (index >= std::to_underlying(xenos::Register::SHADER_CONSTANT_FETCH_00_0) &&
+       index <= std::to_underlying(xenos::Register::SHADER_CONSTANT_FETCH_31_5))) &&
+      register_file_->values[index] == value) {
+    return;
+  }
   CommandProcessor::WriteRegister(index, value);
 
   if (index >= std::to_underlying(xenos::Register::SHADER_CONSTANT_000_X) &&
@@ -1706,6 +1717,18 @@ void D3D12CommandProcessor::WriteRegistersFromMem(u32 start_index, u32* base, u3
   }
   u32 end_index = start_index + num_registers - 1;
 
+  // Titles often send whole constant groups again unchanged; the copy and the binding
+  // invalidation are skipped for those.
+  auto range_unchanged = [&]() {
+    const u32* old_values = register_file_->values + start_index;
+    for (u32 i = 0; i < num_registers; ++i) {
+      if (old_values[i] != memory::load<be_u32>(base + i)) {
+        return false;
+      }
+    }
+    return true;
+  };
+
   auto range_has_any_constant_usage = [](const u64* usage_map, u32 first_constant,
                                          u32 last_constant) -> bool {
     if (first_constant > last_constant) {
@@ -1734,6 +1757,9 @@ void D3D12CommandProcessor::WriteRegistersFromMem(u32 start_index, u32* base, u3
 
   if (start_index >= std::to_underlying(xenos::Register::SHADER_CONSTANT_000_X) &&
       end_index <= std::to_underlying(xenos::Register::SHADER_CONSTANT_511_W)) {
+    if (range_unchanged()) {
+      return;
+    }
     memory::copy_and_swap(register_file_->values + start_index, base, num_registers);
     if (frame_open_) {
       u32 first_float_constant =
@@ -1761,6 +1787,9 @@ void D3D12CommandProcessor::WriteRegistersFromMem(u32 start_index, u32* base, u3
 
   if (start_index >= std::to_underlying(xenos::Register::SHADER_CONSTANT_BOOL_000_031) &&
       end_index <= std::to_underlying(xenos::Register::SHADER_CONSTANT_LOOP_31)) {
+    if (range_unchanged()) {
+      return;
+    }
     memory::copy_and_swap(register_file_->values + start_index, base, num_registers);
     cbuffer_binding_bool_loop_.up_to_date = false;
     return;
@@ -1768,6 +1797,9 @@ void D3D12CommandProcessor::WriteRegistersFromMem(u32 start_index, u32* base, u3
 
   if (start_index >= std::to_underlying(xenos::Register::SHADER_CONSTANT_FETCH_00_0) &&
       end_index <= std::to_underlying(xenos::Register::SHADER_CONSTANT_FETCH_31_5)) {
+    if (range_unchanged()) {
+      return;
+    }
     memory::copy_and_swap(register_file_->values + start_index, base, num_registers);
     cbuffer_binding_fetch_.up_to_date = false;
     u32 first_fetch_dword =
