From 59f8cee4c7981a837cd4d8dcca041b4c03a4bc36 Mon Sep 17 00:00:00 2001
From: gtguerreiro-max <295622337+gtguerreiro-max@users.noreply.github.com>
Date: Tue, 24 Nov 2026 17:59:55 +0000
Subject: [PATCH] tests: the per fetch constant texel conversion bits

TextureIntegerScaleBits (patch 0049): Q16 rounding alone for a normalized unsigned 8-bit fetch, the
point sampling bit, an integer fetch's widths and signs (past the last stored component too), the
swizzle choosing the width it reads, point-sampled 4 to 6 bit widths, unsigned-biased and gamma.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tests/unit/CMakeLists.txt                     |   1 +
 tests/unit/gpu/texture_integer_scale_test.cpp | 109 ++++++++++++++++++
 2 files changed, 110 insertions(+)
 create mode 100644 tests/unit/gpu/texture_integer_scale_test.cpp

diff --git a/tests/unit/CMakeLists.txt b/tests/unit/CMakeLists.txt
index 4b1a0cd1..aa495918 100644
--- a/tests/unit/CMakeLists.txt
+++ b/tests/unit/CMakeLists.txt
@@ -27,6 +27,7 @@ add_executable(
   gpu/packet_header_test.cpp
   gpu/texture_info_test.cpp
   gpu/texture_layout_test.cpp
+  gpu/texture_integer_scale_test.cpp
   gpu/primitive_processor_simd_test.cpp
   gpu/xenos_provider_test.cpp
   gpu/imgui_overlay_test.cpp
diff --git a/tests/unit/gpu/texture_integer_scale_test.cpp b/tests/unit/gpu/texture_integer_scale_test.cpp
new file mode 100644
index 00000000..cae6c175
--- /dev/null
+++ b/tests/unit/gpu/texture_integer_scale_test.cpp
@@ -0,0 +1,109 @@
+/**
+ * @file        tests/unit/gpu/texture_integer_scale_test.cpp
+ *
+ * @brief       The per fetch constant conversion bits of rex/xenos/texture_integer_scale.h
+ *              (Xenia canary's GetIntegerScaleBits).
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include "rex_test.h"
+
+#include <rex/types.h>
+#include <rex/xenos/fetch.h>
+#include <rex/xenos/texture_integer_scale.h>
+
+using rex::u32;
+using rex::u8;
+using rex::xenos::TextureFetch;
+using rex::xenos::TextureIntegerScaleBits;
+
+namespace {
+
+constexpr u32 kNormalized = u32(1) << 24;
+constexpr u32 kPointSampled = u32(1) << 26;
+
+// Swizzle RGBA (X=0, Y=1, Z=2, W=3, 3 bits each).
+constexpr u32 kSwizzleRGBA = 0 | (1 << 3) | (2 << 6) | (3 << 9);
+
+TextureFetch Fetch(rex::xenos::TextureFormat format, bool integer, bool point, u32 swizzle) {
+  TextureFetch f{};
+  f.format = format;
+  f.num_format = integer ? 1 : 0;
+  f.swizzle = swizzle;
+  const auto filter = point ? rex::xenos::TextureFilter::kPoint : rex::xenos::TextureFilter::kLinear;
+  f.mag_filter = filter;
+  f.min_filter = filter;
+  f.mip_filter = filter;
+  f.aniso_filter = rex::xenos::AnisoFilter::kDisabled;
+  return f;
+}
+
+// Component i's 6-bit field: width - 1 in bits 0:3, the sign in 4:5.
+u32 Field(u32 bits, u32 i) { return (bits >> (i * 6)) & 63; }
+
+}  // namespace
+
+REX_TEST_CASE("A normalized unsigned 8-bit fetch only asks for Q16 rounding", "[gpu][texture]") {
+  const u32 bits = TextureIntegerScaleBits(
+      Fetch(rex::xenos::TextureFormat::k_8_8_8_8, false, false, kSwizzleRGBA), 0);
+  CHECK(bits == kNormalized);
+}
+
+REX_TEST_CASE("A point-sampled fetch sets bit 26 whatever the format", "[gpu][texture]") {
+  CHECK((TextureIntegerScaleBits(Fetch(rex::xenos::TextureFormat::k_8_8_8_8, false, true,
+                                       kSwizzleRGBA),
+                                 0) &
+         kPointSampled) != 0);
+  // Not fixed point: no conversion, the point sampling bit alone.
+  CHECK(TextureIntegerScaleBits(Fetch(rex::xenos::TextureFormat::k_16_16_16_16_FLOAT, false,
+                                      true, kSwizzleRGBA),
+                                0) == kPointSampled);
+}
+
+REX_TEST_CASE("An integer fetch carries each component's width and sign", "[gpu][texture]") {
+  // k_16_16, signed (1) in X and Y: width 16 -> field 15 | 1 << 4.
+  const u8 signs = 1 | (1 << 2);
+  const u32 bits = TextureIntegerScaleBits(
+      Fetch(rex::xenos::TextureFormat::k_16_16, true, false, kSwizzleRGBA), signs);
+  CHECK((bits & kNormalized) == 0);
+  CHECK(Field(bits, 0) == (15 | (1 << 4)));
+  CHECK(Field(bits, 1) == (15 | (1 << 4)));
+  // Z and W read past the last stored component (Y), unsigned.
+  CHECK(Field(bits, 2) == 15);
+  CHECK(Field(bits, 3) == 15);
+}
+
+REX_TEST_CASE("The swizzle picks the width of the component it reads", "[gpu][texture]") {
+  // k_10_11_11: R 11 bits, G 11, B 10. Swizzle B, R, 0, 1.
+  const u32 swizzle = 2 | (0 << 3) | (4 << 6) | (5 << 9);
+  const u32 bits =
+      TextureIntegerScaleBits(Fetch(rex::xenos::TextureFormat::k_10_11_11, true, false, swizzle), 0);
+  CHECK(Field(bits, 0) == 9);
+  CHECK(Field(bits, 1) == 10);
+  CHECK(Field(bits, 2) == 0);  // constant 0
+  CHECK(Field(bits, 3) == 0);  // constant 1
+}
+
+REX_TEST_CASE("Point-sampled 4 to 6 bit unsigned components carry their width", "[gpu][texture]") {
+  // k_5_6_5: 5, 6, 5. Normalized, point-sampled: widths carried; linear: not.
+  const u32 point = TextureIntegerScaleBits(
+      Fetch(rex::xenos::TextureFormat::k_5_6_5, false, true, kSwizzleRGBA), 0);
+  CHECK(Field(point, 0) == 4);
+  CHECK(Field(point, 1) == 5);
+  CHECK(Field(point, 2) == 4);
+  const u32 linear = TextureIntegerScaleBits(
+      Fetch(rex::xenos::TextureFormat::k_5_6_5, false, false, kSwizzleRGBA), 0);
+  CHECK(Field(linear, 0) == 0);
+  CHECK(Field(linear, 1) == 0);
+}
+
+REX_TEST_CASE("Unsigned-biased carries its width, gamma does not", "[gpu][texture]") {
+  // X unsigned-biased (2), Y gamma (3).
+  const u8 signs = 2 | (3 << 2);
+  const u32 bits = TextureIntegerScaleBits(
+      Fetch(rex::xenos::TextureFormat::k_8_8_8_8, false, false, kSwizzleRGBA), signs);
+  CHECK(Field(bits, 0) == (7 | (2 << 4)));
+  CHECK(Field(bits, 1) == (3 << 4));
+}
