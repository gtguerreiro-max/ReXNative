 #include "kernel/rexkernel_module.h"
 #include "kernel/title_state.h"
 
@@ -160,7 +161,13 @@ X_STATUS ModuleObject::LoadFromFile(TitleRuntime& owning_runtime, std::string_vi
     }
   }
 
-  return LoadXEXContinue(owning_runtime, *this);
+  result = LoadXEXContinue(owning_runtime, *this);
+  if (result == X_STATUS_SUCCESS) {
+    // Xenia canary's game patches beside the module (<path>.patch.toml), once it is loaded:
+    // codegen reads the patched code, the title runs on the patched data.
+    ApplyGamePatches(owning_runtime, *this);
+  }
+  return result;
 }
 
