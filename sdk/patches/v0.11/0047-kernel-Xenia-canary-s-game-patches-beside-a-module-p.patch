+/**
+ * @file        kernel/game_patches.h
+ * @brief       Xenia canary's game patches for a loaded XEX module.
+ *
+ * A patch file beside a module (`game:\default.xex.patch.toml` for `game:\default.xex`) in Xenia
+ * canary's format (its game-patches repository: title_id, hash, [[patch]] tables with be8, be16,
+ * be32, be64, f32, f64, string, u16string and array writes) is applied to the module's memory once
+ * it is loaded, before codegen reads it or the title runs: the patches whose `is_enabled` is true,
+ * and only when the file's title id is the module's and one of its hashes is the module hash as
+ * Xenia canary computes it (UserModule::CalculateHash). Codegen and the title load the module the
+ * same way, so a code patch is in the recompiled code and a data patch in the title's memory.
+ */
+#pragma once
+
+#include <optional>
+
+#include <rex/types.h>
+
+namespace rex::kernel {
+
+struct ModuleObject;
+class TitleRuntime;
+
+/**
+ * The module hash Xenia canary gives a loaded XEX module: XXH3-64 over its code pages, the import
+ * thunks as Xenia canary rewrites them (`sc 2; blr; nop; nop`). Nothing for a patch module or a
+ * module that is not loaded.
+ */
+std::optional<u64> GameModuleHash(TitleRuntime& runtime, ModuleObject& module);
+
+/** Applies `<module path>.patch.toml`, when there is one, to a module LoadFromFile loaded. */
+void ApplyGamePatches(TitleRuntime& runtime, ModuleObject& module);
+
+}  // namespace rex::kernel
