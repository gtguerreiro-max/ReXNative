diff --git a/src/base/threading_win.cpp b/src/base/threading_win.cpp
index 9e575853..8c473844 100644
--- a/src/base/threading_win.cpp
+++ b/src/base/threading_win.cpp
@@ -106,6 +106,27 @@ void SyncMemory() {
   MemoryBarrier();
 }
 
+bool WaitOnWord(const std::atomic<u32>& word, u32 expected, std::chrono::milliseconds timeout) {
+  static_assert(sizeof(std::atomic<u32>) == sizeof(u32));
+  const DWORD milliseconds = timeout >= std::chrono::milliseconds(INFINITE)
+                                 ? INFINITE
+                                 : static_cast<DWORD>(std::max<i64>(timeout.count(), 0));
+  // NOLINTNEXTLINE(cppcoreguidelines-pro-type-const-cast): WaitOnAddress only reads the word
+  void* address = const_cast<std::atomic<u32>*>(&word);
+  if (::WaitOnAddress(address, &expected, sizeof(u32), milliseconds)) {
+    return true;
+  }
+  return GetLastError() != ERROR_TIMEOUT;
+}
+
+void WakeOneOnWord(std::atomic<u32>& word) {
+  ::WakeByAddressSingle(&word);
+}
+
+void WakeAllOnWord(std::atomic<u32>& word) {
+  ::WakeByAddressAll(&word);
+}
