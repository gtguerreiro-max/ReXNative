--- /dev/null
+++ b/tests/unit/kernel/fast_wait_test.cpp
@@ -0,0 +1,312 @@
+/**
+ * @file        tests/unit/kernel/fast_wait_test.cpp
+ * @brief       Events, semaphores and critical sections kept in user space (runtime.fast_waits)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include "rex_test.h"
+
+#include <atomic>
+#include <chrono>
+#include <memory>
+#include <thread>
+#include <vector>
+
+#include <rex/kernel/object/kernel_thread.h>
+#include <rex/kernel/title_runtime.h>
+#include <rex/kernel/thread_registry.h>
+#include <rex/kernel/types/status.h>
+
+#include "kernel/kernel_fixture.h"
+
+using rex::test::Caller;
+using rex::test::Join;
+using rex::test::KernelFixture;
+
+namespace {
+
+constexpr u32 kTimeout = rex::kernel::X_STATUS_TIMEOUT;
+constexpr i64 kForever = 0;
+constexpr auto kSettle = std::chrono::milliseconds(100);
+
+u32 Create(Caller& c, const char* name, u64 first, u64 second) {
+  const u32 handle_ptr = c.Alloc(4);
+  CHECKED_ELSE(c.Kernel(name, {handle_ptr, 0, first, second}) == 0) {
+    FAIL_CHECK("the check above failed");
+    return 0;
+  }
+  return c.Load32(handle_ptr);
+}
+
+u32 Wait(Caller& c, u32 handle, i64 timeout) {
+  return c.Kernel("NtWaitForSingleObjectEx", {handle, 1, 0, timeout ? c.AllocQuad(timeout) : 0});
+}
+
+/** Starts threads that each wait once on the handle and count their return. */
+std::vector<u32> Waiters(Caller& c, u32 handle, int count,
+                         std::shared_ptr<std::atomic<int>> woken) {
+  std::vector<u32> threads;
+  for (int i = 0; i < count; ++i) {
+    threads.push_back(c.Spawn([handle, woken](Caller& t) {
+      if (Wait(t, handle, kForever) == 0) {
+        woken->fetch_add(1);
+      }
+    }));
+  }
+  std::this_thread::sleep_for(kSettle);
+  return threads;
+}
+
+}  // namespace
+
+REX_TEST_CASE("fast waits: a release hands its counts to the queued threads before a new wait",
+              "[kernel][semaphores][fast]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([](Caller& c) {
+    const u32 sem = Create(c, "NtCreateSemaphore", 0, 10);
+    auto woken = std::make_shared<std::atomic<int>>(0);
+    const auto threads = Waiters(c, sem, 3, woken);
+    const u32 previous = c.Alloc(4);
+    CHECK(c.Kernel("NtReleaseSemaphore", {sem, 2, previous}) == 0);
+    CHECK(c.Load32(previous) == 0);
+    // Both counts went to queued threads: none is left for a wait that starts now.
+    CHECK(Wait(c, sem, -1) == kTimeout);
+    std::this_thread::sleep_for(kSettle);
+    CHECK(woken->load() == 2);
+    CHECK(c.Kernel("NtReleaseSemaphore", {sem, 1, previous}) == 0);
+    for (u32 thread : threads) {
+      Join(c, thread);
+    }
+    CHECK(woken->load() == 3);
+    CHECK(Wait(c, sem, -1) == kTimeout);
+    c.Kernel("NtClose", {sem});
+  });
+}
+
+REX_TEST_CASE("fast waits: a manual reset event set then cleared releases every queued thread",
+              "[kernel][events][fast]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([](Caller& c) {
+    const u32 event = Create(c, "NtCreateEvent", 0, 0);
+    auto woken = std::make_shared<std::atomic<int>>(0);
+    const auto threads = Waiters(c, event, 3, woken);
+    CHECK(c.Kernel("NtSetEvent", {event, 0}) == 0);
+    CHECK(c.Kernel("NtClearEvent", {event}) == 0);
+    for (u32 thread : threads) {
+      Join(c, thread);
+    }
+    CHECK(woken->load() == 3);
+    CHECK(Wait(c, event, -1) == kTimeout);
+    c.Kernel("NtClose", {event});
+  });
+}
+
+REX_TEST_CASE("fast waits: an auto reset event set then cleared releases one queued thread",
+              "[kernel][events][fast]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([](Caller& c) {
+    const u32 event = Create(c, "NtCreateEvent", 1, 0);
+    auto woken = std::make_shared<std::atomic<int>>(0);
+    const auto threads = Waiters(c, event, 2, woken);
+    CHECK(c.Kernel("NtSetEvent", {event, 0}) == 0);
+    CHECK(c.Kernel("NtClearEvent", {event}) == 0);
+    std::this_thread::sleep_for(kSettle);
+    CHECK(woken->load() == 1);
+    CHECK(c.Kernel("NtSetEvent", {event, 0}) == 0);
+    for (u32 thread : threads) {
+      Join(c, thread);
+    }
+    CHECK(woken->load() == 2);
+    CHECK(Wait(c, event, -1) == kTimeout);
+    c.Kernel("NtClose", {event});
+  });
+}
+
+REX_TEST_CASE("fast waits: a pulse releases the queued threads and leaves the event clear",
+              "[kernel][events][fast]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([](Caller& c) {
+    const u32 event = Create(c, "NtCreateEvent", 0, 0);
+    auto woken = std::make_shared<std::atomic<int>>(0);
+    const auto threads = Waiters(c, event, 2, woken);
+    CHECK(c.Kernel("NtPulseEvent", {event, 0}) == 0);
+    for (u32 thread : threads) {
+      Join(c, thread);
+    }
+    CHECK(woken->load() == 2);
+    CHECK(Wait(c, event, -1) == kTimeout);
+    c.Kernel("NtClose", {event});
+  });
+}
+
+REX_TEST_CASE("fast waits: a wait on several objects takes over an event a thread is queued on",
+              "[kernel][events][fast]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([](Caller& c) {
+    const u32 event = Create(c, "NtCreateEvent", 1, 0);
+    const u32 other = Create(c, "NtCreateEvent", 1, 0);
+    auto woken = std::make_shared<std::atomic<int>>(0);
+    const auto single = Waiters(c, event, 1, woken);
+    const u32 handles = c.Alloc(8);
+    c.Store32(handles, event);
+    c.Store32(handles + 4, other);
+    const u32 multiple = c.Spawn([handles, woken](Caller& t) {
+      if (t.Kernel("NtWaitForMultipleObjectsEx", {2, handles, 1, 1, 0, 0}) == 0) {
+        woken->fetch_add(1);
+      }
+    });
+    std::this_thread::sleep_for(kSettle);
+    CHECK(woken->load() == 0);
+    // An auto reset event: each set releases one of the two threads.
+    CHECK(c.Kernel("NtSetEvent", {event, 0}) == 0);
+    std::this_thread::sleep_for(kSettle);
+    CHECK(woken->load() == 1);
+    CHECK(c.Kernel("NtSetEvent", {event, 0}) == 0);
+    Join(c, single[0]);
+    Join(c, multiple);
+    CHECK(woken->load() == 2);
+    CHECK(Wait(c, event, -1) == kTimeout);
+    c.Kernel("NtClose", {event});
+    c.Kernel("NtClose", {other});
+  });
+}
+
+REX_TEST_CASE("fast waits: a suspended thread leaves its wait and takes no count until resumed",
+              "[kernel][semaphores][fast]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([](Caller& c) {
+    const u32 sem = Create(c, "NtCreateSemaphore", 0, 10);
+    auto woken = std::make_shared<std::atomic<int>>(0);
+    const auto threads = Waiters(c, sem, 1, woken);
+    CHECK(c.Kernel("NtSuspendThread", {threads[0], 0}) == 0);
+    std::this_thread::sleep_for(kSettle);
+    CHECK(c.Kernel("NtReleaseSemaphore", {sem, 1, 0}) == 0);
+    std::this_thread::sleep_for(kSettle);
+    CHECK(woken->load() == 0);
+    // The suspended thread is not waiting: the count is there for this thread.
+    CHECK(Wait(c, sem, -1) == 0);
+    CHECK(c.Kernel("NtResumeThread", {threads[0], 0}) == 0);
+    std::this_thread::sleep_for(kSettle);
+    CHECK(woken->load() == 0);
+    CHECK(c.Kernel("NtReleaseSemaphore", {sem, 1, 0}) == 0);
+    Join(c, threads[0]);
+    CHECK(woken->load() == 1);
+    c.Kernel("NtClose", {sem});
+  });
