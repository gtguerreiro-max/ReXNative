@@ -17,6 +17,8 @@
 #include <rex/chrono.h>
 #include <rex/kernel/xboxkrnl.h>
 #include <rex/logging/log_category.h>
+#include "kernel/object/fast_sync.h"
+#include "kernel/wait_stats.h"
 #include "kernel/categories.h"
 #include <rex/ppc/hook.h>
 #include <rex/memory/mapped_ptr.h>
@@ -445,16 +447,50 @@ void RtlEnterCriticalSection_entry(GuestPtrT<X_RTL_CRITICAL_SECTION> cs) {
     return;
   }
 
-  while (spin_count--) {
-    if (TryAcquireLockCount(*cs)) {
-      cs->owning_thread = cur_thread;
-      cs->recursion_count = 1;
-      return;
+  const bool fast_waits = fast::Enabled();
+  if (fast_waits && TryAcquireLockCount(*cs)) {
+    cs->owning_thread = cur_thread;
+    cs->recursion_count = 1;
+    return;
+  }
+
+  wait_stats::Timer stats(wait_stats::Kind::kCriticalSection);
+  if (fast_waits) {
+    // A few microseconds by the clock, whatever the title's spin count: the owner usually leaves
+    // within them, and a sleep costs a system call and a wake-up on each side. The pause lets the
+    // owner run on a sibling hardware thread.
+    if (const u64 spin = fast::SpinTicks()) {
+      const u64 end = fast::Ticks() + spin;
+      do {
+        for (int i = 0; i < 4; ++i) {
+          fast::Pause();
+        }
+        if (LockCount(*cs).load(std::memory_order_relaxed) == -1 && TryAcquireLockCount(*cs)) {
+          cs->owning_thread = cur_thread;
+          cs->recursion_count = 1;
+          stats.SetPath(wait_stats::Path::kSpun);
+          return;
+        }
+      } while (fast::Ticks() < end);
+    }
+  } else {
+    while (spin_count--) {
+      if (TryAcquireLockCount(*cs)) {
+        cs->owning_thread = cur_thread;
+        cs->recursion_count = 1;
+        stats.SetPath(wait_stats::Path::kSpun);
+        return;
+      }
     }
   }
 
   if (++LockCount(*cs) != 0) {
+    // The section's event records how the wait ended.
+    wait_stats::Suppress inner;
     KeWaitForSingleObject(cs.GetGuestAddress(), 8, 0, 0, nullptr);
+    stats.SetPath(wait_stats::TakePath());
+  } else {
+    stats.SetPath(wait_stats::Path::kSpun);
   }
 
   REX_ASSERT(cs->owning_thread == 0);
@@ -491,6 +527,10 @@ void RtlLeaveCriticalSection_entry(GuestPtrT<X_RTL_CRITICAL_SECTION> cs) {
 
   cs->owning_thread = 0;
   if (--LockCount(*cs) != -1) {
+    if (wait_stats::Enabled()) {
+      wait_stats::RecordSignal(wait_stats::Signal::kCriticalSection);
+    }
+    wait_stats::Suppress inner;
     KeSetEvent(cs.GetGuestAddress(), 1, 0);
   }
 }
