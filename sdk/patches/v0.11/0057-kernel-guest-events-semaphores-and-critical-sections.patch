+ * @param expected The value the thread sleeps on.
+ * @param timeout The longest sleep, milliseconds::max() for no limit.
+ * @return False when the timeout elapsed.
+ */
+REX_API bool WaitOnWord(const std::atomic<u32>& word, u32 expected,
+                        std::chrono::milliseconds timeout);
+
+/** Wakes one thread sleeping in WaitOnWord on the word. Costs no system call without a sleeper. */
+REX_API void WakeOneOnWord(std::atomic<u32>& word);
+
+/** Wakes every thread sleeping in WaitOnWord on the word. */
+REX_API void WakeAllOnWord(std::atomic<u32>& word);
+
 /** Event that clears its own signal once the last waiter returns from Wait. */
