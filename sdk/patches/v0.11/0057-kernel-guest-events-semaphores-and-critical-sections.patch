+/**
+ * @file        kernel/wait_stats.cpp
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include "kernel/wait_stats.h"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <format>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include <rex/kernel/object/kernel_thread.h>
+
+#include "kernel/categories.h"
+#include "kernel/object/fast_sync.h"
+#include "kernel/settings_access.h"
+
+namespace rex::kernel::wait_stats {
+
+namespace {
+
+constexpr size_t kKinds = static_cast<size_t>(Kind::kCount);
+constexpr size_t kPaths = static_cast<size_t>(Path::kCount);
+constexpr size_t kSignals = static_cast<size_t>(Signal::kCount);
+constexpr auto kReportEvery = std::chrono::seconds(5);
+constexpr auto kBlockedAbove = std::chrono::microseconds(5);
+
+constexpr const char* kKindNames[kKinds] = {"cs",    "event", "sem",   "mutant",  "timer", "thread",
+                                            "other", "any",   "multi", "sigwait", "delay", "yield"};
+constexpr const char* kSignalNames[kSignals] = {"event", "sem", "cs"};
+
+struct Counts {
+  std::array<std::array<u64, kPaths>, kKinds> waits{};
+  std::array<u64, kKinds> wait_ns{};
+  std::array<u64, kSignals> signals{};
+  u64 alertable = 0;
+};
+
+/** The counters of one thread. Only the thread writes them, the reporter reads them. */
+struct ThreadCounters {
+  std::array<std::array<std::atomic<u64>, kPaths>, kKinds> waits{};
+  std::array<std::atomic<u64>, kKinds> wait_ns{};
+  std::array<std::atomic<u64>, kSignals> signals{};
+  std::atomic<u64> alertable{0};
+  std::string name;
+  u32 thread_id = 0;
+  Counts last; /**< What the previous report saw, which only the reporter touches. */
+
+  Counts Read() const {
+    Counts out;
+    for (size_t k = 0; k < kKinds; ++k) {
+      for (size_t p = 0; p < kPaths; ++p) {
+        out.waits[k][p] = waits[k][p].load(std::memory_order_relaxed);
+      }
+      out.wait_ns[k] = wait_ns[k].load(std::memory_order_relaxed);
+    }
+    for (size_t s = 0; s < kSignals; ++s) {
+      out.signals[s] = signals[s].load(std::memory_order_relaxed);
+    }
+    out.alertable = alertable.load(std::memory_order_relaxed);
+    return out;
+  }
+};
+
+std::mutex g_threads_mutex;
+std::vector<std::unique_ptr<ThreadCounters>> g_threads;
+std::atomic<i64> g_next_report{0};
+std::chrono::steady_clock::time_point g_last_report;
+thread_local ThreadCounters* t_counters = nullptr;
+thread_local u32 t_suppress = 0;
+thread_local Path t_last_path = Path::kCount;
+
+void Bump(std::atomic<u64>& counter, u64 amount) {
+  counter.store(counter.load(std::memory_order_relaxed) + amount, std::memory_order_relaxed);
+}
+
+ThreadCounters& Mine() {
+  if (!t_counters) {
+    auto counters = std::make_unique<ThreadCounters>();
+    if (KernelThread::IsInThread()) {
+      KernelThread* thread = KernelThread::GetCallingThread();
+      counters->name = thread->GetName();
+      counters->thread_id = thread->GetThreadID();
+    } else {
+      counters->name = "host";
+    }
+    std::lock_guard lock(g_threads_mutex);
+    t_counters = counters.get();
+    g_threads.push_back(std::move(counters));
+  }
+  return *t_counters;
+}
+
+void Report(std::chrono::steady_clock::time_point now) {
+  std::lock_guard lock(g_threads_mutex);
+  const double seconds = g_last_report.time_since_epoch().count() == 0
+                             ? std::chrono::duration<double>(kReportEvery).count()
+                             : std::chrono::duration<double>(now - g_last_report).count();
+  g_last_report = now;
+  struct Row {
+    double blocked;
+    std::string text;
+  };
+  std::vector<Row> rows;
+  for (auto& thread : g_threads) {
+    const Counts now_counts = thread->Read();
+    Counts d;
+    u64 any = 0;
+    double blocked = 0;
+    for (size_t k = 0; k < kKinds; ++k) {
+      for (size_t p = 0; p < kPaths; ++p) {
+        d.waits[k][p] = now_counts.waits[k][p] - thread->last.waits[k][p];
+        any += d.waits[k][p];
+      }
+      d.wait_ns[k] = now_counts.wait_ns[k] - thread->last.wait_ns[k];
+      blocked += static_cast<double>(d.waits[k][static_cast<size_t>(Path::kSlept)] +
+                                     d.waits[k][static_cast<size_t>(Path::kHostLong)]);
+    }
+    for (size_t s = 0; s < kSignals; ++s) {
+      d.signals[s] = now_counts.signals[s] - thread->last.signals[s];
+      any += d.signals[s];
+    }
+    d.alertable = now_counts.alertable - thread->last.alertable;
+    thread->last = now_counts;
+    if (!any) {
+      continue;
+    }
+    std::string text = std::format("'{}' ({:X}):", thread->name, thread->thread_id);
+    u64 total_ns = 0;
+    for (size_t k = 0; k < kKinds; ++k) {
+      const auto& w = d.waits[k];
+      const u64 n = w[0] + w[1] + w[2] + w[3] + w[4];
+      total_ns += d.wait_ns[k];
+      if (!n) {
+        continue;
+      }
+      // Per second: all, then user space immediate / spun / slept, then host quick / long.
+      text += std::format(" {} {:.0f} (i{:.0f} s{:.0f} z{:.0f} h{:.0f}/{:.0f})", kKindNames[k],
+                          n / seconds, w[0] / seconds, w[1] / seconds, w[2] / seconds,
+                          w[3] / seconds, w[4] / seconds);
+    }
+    for (size_t s = 0; s < kSignals; ++s) {
+      if (d.signals[s]) {
+        text += std::format(" | {}+ {:.0f}", kSignalNames[s], d.signals[s] / seconds);
+      }
+    }
+    if (d.alertable) {
+      text += std::format(" | alertable {:.0f}", d.alertable / seconds);
+    }
+    text += std::format(" | in waits {:.1f} ms/s", total_ns / 1e6 / seconds);
+    rows.push_back({blocked / seconds, std::move(text)});
+  }
+  std::sort(rows.begin(), rows.end(),
+            [](const Row& a, const Row& b) { return a.blocked > b.blocked; });
+  REXKRNL_INFO(
+      "wait stats over {:.1f} s, per second (i immediate, s spun, z slept, h host quick/long); "
+      "fast waits {}, spin {} us, "
+      "{} objects moved to the host",
+      seconds, fast::Enabled() ? "on" : "off", GetRuntimeSettings().wait_spin_us.Get(),
+      fast::HostMoves());
+  for (size_t i = 0; i < rows.size() && i < 16; ++i) {
+    REXKRNL_INFO("  wait stats {:.0f} blocked/s {}", rows[i].blocked, rows[i].text);
+  }
+}
+
+void MaybeReport() {
+  const auto now = std::chrono::steady_clock::now();
+  const i64 now_ns = now.time_since_epoch().count();
+  i64 next = g_next_report.load(std::memory_order_relaxed);
+  if (now_ns < next) {
+    return;
+  }
+  const i64 after =
+      now_ns +
+      std::chrono::duration_cast<std::chrono::steady_clock::duration>(kReportEvery).count();
+  if (!g_next_report.compare_exchange_strong(next, after, std::memory_order_relaxed)) {
+    return;
+  }
+  if (next == 0) {
+    // The first call only starts the clock.
+    std::lock_guard lock(g_threads_mutex);
+    g_last_report = now;
+    for (auto& thread : g_threads) {
+      thread->last = thread->Read();
+    }
+    return;
+  }
+  Report(now);
+}
+
+}  // namespace
+
+bool Enabled() {
+  return GetRuntimeSettings().wait_stats.Get();
+}
+
+void NotePath(Path path) {
+  t_last_path = path;
+}
+
+Path TakePath() {
+  const Path path = t_last_path;
+  t_last_path = Path::kCount;
+  return path;
+}
+
+void RecordWait(Kind kind, std::chrono::nanoseconds took, Path path, bool alertable) {
+  if (path == Path::kCount) {
+    path = took > kBlockedAbove ? Path::kHostLong : Path::kHostQuick;
+  }
+  t_last_path = path;
+  if (t_suppress) {
+    return;
+  }
+  ThreadCounters& mine = Mine();
+  const auto k = static_cast<size_t>(kind);
+  Bump(mine.waits[k][static_cast<size_t>(path)], 1);
+  Bump(mine.wait_ns[k], static_cast<u64>(std::max<i64>(took.count(), 0)));
+  if (alertable) {
+    Bump(mine.alertable, 1);
+  }
+  MaybeReport();
+}
+
+void RecordSignal(Signal signal) {
+  if (t_suppress) {
+    return;
+  }
+  Bump(Mine().signals[static_cast<size_t>(signal)], 1);
+  MaybeReport();
+}
+
+Timer::Timer(Kind kind, bool alertable) : kind_(kind), alertable_(alertable), on_(Enabled()) {
+  if (on_) {
+    start_ = std::chrono::steady_clock::now();
+  }
+}
+
+Timer::~Timer() {
+  if (on_) {
+    RecordWait(kind_, std::chrono::steady_clock::now() - start_, path_, alertable_);
+  }
+}
+
+Suppress::Suppress() {
+  ++t_suppress;
+}
+
+Suppress::~Suppress() {
+  --t_suppress;
+}
+
+bool Suppress::Active() {
+  return t_suppress != 0;
+}
+
+}  // namespace rex::kernel::wait_stats
