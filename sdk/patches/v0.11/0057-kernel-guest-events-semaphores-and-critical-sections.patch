diff --git a/src/kernel/object/fast_sync.cpp b/src/kernel/object/fast_sync.cpp
new file mode 100644
index 00000000..61b06801
--- /dev/null
+++ b/src/kernel/object/fast_sync.cpp
@@ -0,0 +1,561 @@
+/**
+ * @file        kernel/object/fast_sync.cpp
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include "kernel/object/fast_sync.h"
+
+#include <algorithm>
+#include <limits>
+
+#include <rex/kernel/object/kernel_thread.h>
+#include <rex/platform.h>
+#include <rex/platform/sync.h>
+#include <rex/platform/thread.h>
+
+#include "kernel/settings_access.h"
+
+#if REX_ARCH_AMD64
+#if defined(_MSC_VER)
+#include <intrin.h>
+#else
+#include <x86intrin.h>
+#endif
+#endif
+
+namespace rex::kernel {
+
+/** A thread queued on a FastState. It lives on the waiting thread's stack. */
+struct FastWaiter {
+  FastWaiter* next = nullptr;
+  FastWaiter* prev = nullptr;
+  std::atomic<u32>* park = nullptr; /**< The waiting thread's park word. */
+  /** 0 while it waits, 1 once a signal is its, 2 once the object moved to its host primitive. */
+  std::atomic<u32> outcome{0};
+};
+
+}  // namespace rex::kernel
+
+namespace rex::kernel::fast {
+
+namespace {
+
+constexpr u64 kValueMask = FastState::kValueMask;
+constexpr u64 kMigrating = FastState::kMigrating;
+constexpr u64 kHost = FastState::kHost;
+constexpr u32 kGiven = 1;
+constexpr u32 kMoved = 2;
+/** Taken out of the queue by a guest initializer, as the kernel's InitializeListHead drops it. */
+constexpr u32 kOrphaned = 3;
+/** Park word bits: the thread's object chose it, or a stop or suspend request needs it. */
+constexpr u32 kParkSignal = 1;
+constexpr u32 kParkInterrupt = 2;
+
+std::atomic<u64> g_host_moves{0};
+thread_local u8 t_last_path = 0;
+
+void Lock(FastState& state) {
+  u32 spins = 0;
+  while (state.lock.exchange(1, std::memory_order_acquire)) {
+    while (state.lock.load(std::memory_order_relaxed)) {
+      if (++spins < 128) {
+        Pause();
+      } else {
+        // The holder may be off its core: give it the processor.
+        rex::platform::MaybeYield();
+        spins = 0;
+      }
+    }
+  }
+}
+
+void Unlock(FastState& state) {
+  state.lock.store(0, std::memory_order_release);
+}
+
+void Append(FastState& state, FastWaiter* node) {
+  node->prev = state.tail;
+  node->next = nullptr;
+  if (state.tail) {
+    state.tail->next = node;
+  } else {
+    state.head = node;
+  }
+  state.tail = node;
+}
+
+void Unlink(FastState& state, FastWaiter* node) {
+  if (node->prev) {
+    node->prev->next = node->next;
+  } else {
+    state.head = node->next;
+  }
+  if (node->next) {
+    node->next->prev = node->prev;
+  } else {
+    state.tail = node->prev;
+  }
+  node->next = node->prev = nullptr;
+  state.queued.fetch_sub(1, std::memory_order_seq_cst);
+}
+
+/**
+ * Takes the oldest queued thread out of the queue with an outcome and wakes it. Under the lock,
+ * which the woken thread takes once before it returns, so the node and the park word stay valid.
+ */
+void Satisfy(FastState& state, u32 outcome) {
+  FastWaiter* node = state.head;
+  Unlink(state, node);
+  node->outcome.store(outcome, std::memory_order_release);
+  node->park->fetch_or(kParkSignal, std::memory_order_seq_cst);
+  rex::platform::WakeOneOnWord(*node->park);
+}
+
+/** Waits out a move to the host primitive, which another thread does under the lock. */
+u64 Settled(const FastState& state, u64 word) {
+  u32 spins = 0;
+  while (word & kMigrating) {
+    if (++spins < 128) {
+      Pause();
+    } else {
+      rex::platform::MaybeYield();
+      spins = 0;
+    }
+    word = state.word.load(std::memory_order_seq_cst);
+  }
+  return word;
+}
+
+enum class Take : u8 { kTaken, kEmpty, kHost };
+
+Take TryTake(FastState& state, Kind kind) {
+  u64 word = state.word.load(std::memory_order_seq_cst);
+  for (;;) {
+    if (word & kMigrating) {
+      word = Settled(state, word);
+      continue;
+    }
+    if (word & kHost) {
+      return Take::kHost;
+    }
+    if (!(word & kValueMask)) {
+      return Take::kEmpty;
+    }
+    if (kind == Kind::kManualEvent) {
+      return Take::kTaken;
+    }
+    // The flags sit above the value, so taking one never borrows from them.
+    if (state.word.compare_exchange_weak(word, word - 1, std::memory_order_seq_cst)) {
+      return Take::kTaken;
+    }
+  }
+}
+
+/** Under the lock: hands what the word holds to the queued threads, oldest first. */
+void Hand(FastState& state, Kind kind) {
+  while (state.head) {
+    u64 word = state.word.load(std::memory_order_seq_cst);
+    if (!(word & kValueMask)) {
+      return;
+    }
+    if (kind == Kind::kManualEvent) {
+      while (state.head) {
+        Satisfy(state, kGiven);
+      }
+      return;
+    }
+    if (state.word.compare_exchange_weak(word, word - 1, std::memory_order_seq_cst)) {
+      Satisfy(state, kGiven);
+    }
+  }
+}
+
+/** Sets the value word with a compare and swap, keeping the flags, until it holds. */
+void Store(FastState& state, u32 value) {
+  u64 word = state.word.load(std::memory_order_seq_cst);
+  while (static_cast<u32>(word) != value &&
+         !state.word.compare_exchange_weak(word, (word & ~kValueMask) | value,
+                                           std::memory_order_seq_cst)) {}
+}
+
+u64 MeasureTicksPerMicrosecond() {
+  using clock = std::chrono::steady_clock;
+  const auto t0 = clock::now();
+  const u64 c0 = Ticks();
+  while (clock::now() - t0 < std::chrono::milliseconds(2)) {
+    Pause();
+  }
+  const auto t1 = clock::now();
+  const u64 c1 = Ticks();
+  const auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(t1 - t0).count();
+  return std::max<u64>(1, (c1 - c0) * 1000 / static_cast<u64>(std::max<i64>(ns, 1)));
+}
+
+}  // namespace
+
+u64 TicksPerMicrosecond() {
+  static std::atomic<u64> cached{0};
+  u64 value = cached.load(std::memory_order_relaxed);
+  if (!value) {
+    value = MeasureTicksPerMicrosecond();
+    cached.store(value, std::memory_order_relaxed);
+  }
+  return value;
+}
+
+bool Enabled() {
+  return GetRuntimeSettings().fast_waits.Get();
+}
+
+u64 Ticks() {
+#if REX_ARCH_AMD64
+  return __rdtsc();
+#else
+  return static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                              std::chrono::steady_clock::now().time_since_epoch())
+                              .count());
+#endif
+}
+
+void Pause() {
+#if REX_ARCH_AMD64
+  _mm_pause();
+#elif defined(_MSC_VER)
+  __yield();
+#else
+  __asm__ __volatile__("yield");
+#endif
+}
+
+u64 SpinTicks() {
+  const u32 microseconds = GetRuntimeSettings().wait_spin_us.Get();
+  return microseconds ? microseconds * TicksPerMicrosecond() : 0;
+}
+
+void Init(FastState& state, u32 value) {
+  state.word.store(value, std::memory_order_relaxed);
+}
+
+bool IsHost(const FastState& state) {
+  return (state.word.load(std::memory_order_acquire) & kHost) != 0;
+}
+
+Result Set(FastState& state, Kind kind) {
+  if (!state.queued.load(std::memory_order_seq_cst)) {
+    u64 word = state.word.load(std::memory_order_seq_cst);
+    for (;;) {
+      if (word & kMigrating) {
+        word = Settled(state, word);
+        continue;
+      }
+      if (word & kHost) {
+        return Result::kHost;
+      }
+      if (word & kValueMask) {
+        std::atomic_thread_fence(std::memory_order_seq_cst);
+        break;
+      }
+      if (state.word.compare_exchange_weak(word, word | 1, std::memory_order_seq_cst)) {
+        break;
+      }
+    }
+    // A thread that queued meanwhile looked at the word before this set: hand it the signal.
+    if (!state.queued.load(std::memory_order_seq_cst)) {
+      return Result::kDone;
+    }
+    Lock(state);
+    if (!(state.word.load(std::memory_order_seq_cst) & kHost)) {
+      Hand(state, kind);
+    }
+    Unlock(state);
+    return Result::kDone;
+  }
+  Lock(state);
+  if (state.word.load(std::memory_order_seq_cst) & kHost) {
+    Unlock(state);
+    return Result::kHost;
+  }
+  if (kind == Kind::kManualEvent) {
+    Store(state, 1);
+    while (state.head) {
+      Satisfy(state, kGiven);
+    }
+  } else if (state.head && !(state.word.load(std::memory_order_seq_cst) & kValueMask)) {
+    // Straight to the oldest waiter: the event stays unsignaled.
+    Satisfy(state, kGiven);
+  } else {
+    Store(state, 1);
+    Hand(state, kind);
+  }
+  Unlock(state);
+  return Result::kDone;
+}
+
+Result Reset(FastState& state) {
+  u64 word = state.word.load(std::memory_order_seq_cst);
+  for (;;) {
+    if (word & kMigrating) {
+      word = Settled(state, word);
+      continue;
+    }
+    if (word & kHost) {
+      return Result::kHost;
+    }
+    if (!(word & kValueMask) ||
+        state.word.compare_exchange_weak(word, word & ~kValueMask, std::memory_order_seq_cst)) {
+      return Result::kDone;
+    }
+  }
+}
+
+Result Pulse(FastState& state, Kind kind) {
+  Lock(state);
+  if (state.word.load(std::memory_order_seq_cst) & kHost) {
+    Unlock(state);
+    return Result::kHost;
+  }
+  if (kind == Kind::kManualEvent) {
+    while (state.head) {
+      Satisfy(state, kGiven);
+    }
+  } else if (state.head) {
+    Satisfy(state, kGiven);
+  }
+  Store(state, 0);
+  Unlock(state);
+  return Result::kDone;
+}
+
+Result Release(FastState& state, u32 count, u32 limit, u32* previous) {
+  *previous = 0;
+  if (!count || count > static_cast<u32>(std::numeric_limits<i32>::max())) {
+    return Result::kLimit;
+  }
+  if (!state.queued.load(std::memory_order_seq_cst)) {
+    u64 word = state.word.load(std::memory_order_seq_cst);
+    for (;;) {
+      if (word & kMigrating) {
+        word = Settled(state, word);
+        continue;
+      }
+      if (word & kHost) {
+        return Result::kHost;
+      }
+      if (static_cast<u64>(static_cast<u32>(word)) + count > limit) {
+        return Result::kLimit;
+      }
+      if (state.word.compare_exchange_weak(word, word + count, std::memory_order_seq_cst)) {
+        break;
+      }
+    }
+    *previous = static_cast<u32>(word);
+    if (!state.queued.load(std::memory_order_seq_cst)) {
+      return Result::kDone;
+    }
+    Lock(state);
+    if (!(state.word.load(std::memory_order_seq_cst) & kHost)) {
+      Hand(state, Kind::kSemaphore);
+    }
+    Unlock(state);
+    return Result::kDone;
+  }
+  Lock(state);
+  u64 word = state.word.load(std::memory_order_seq_cst);
+  if (word & kHost) {
+    Unlock(state);
+    return Result::kHost;
+  }
+  // The queued threads take their counts in the same step, so no spinning thread takes one first.
+  for (;;) {
+    const u32 value = static_cast<u32>(word);
+    if (static_cast<u64>(value) + count > limit) {
+      Unlock(state);
+      return Result::kLimit;
+    }
+    const u32 queued = state.queued.load(std::memory_order_relaxed);
+    const u32 given = std::min(value + count, queued);
+    if (state.word.compare_exchange_weak(word, word + count - given, std::memory_order_seq_cst)) {
+      *previous = value;
+      for (u32 i = 0; i < given; ++i) {
+        Satisfy(state, kGiven);
+      }
+      break;
+    }
+  }
+  Unlock(state);
+  return Result::kDone;
+}
+
+bool Read(const FastState& state, u32* value) {
+  const u64 word = Settled(state, state.word.load(std::memory_order_seq_cst));
+  if (word & kHost) {
+    return false;
+  }
+  *value = static_cast<u32>(word);
+  return true;
+}
+
+u8 LastPath() {
+  return t_last_path;
+}
+
+WaitResult Wait(FastState& state, Kind kind, std::chrono::milliseconds timeout,
+                KernelThread* self) {
+  t_last_path = 0;
+  switch (TryTake(state, kind)) {
+    case Take::kTaken:
+      return WaitResult::kTaken;
+    case Take::kHost:
+      return WaitResult::kHost;
+    case Take::kEmpty:
+      break;
+  }
+  if (timeout.count() <= 0) {
+    return WaitResult::kTimeout;
+  }
+  // Spin a few microseconds: the signal usually comes from a thread running on another core.
+  // Not behind queued threads, which a signal reaches first.
+  t_last_path = 1;
+  if (const u64 spin = SpinTicks(); spin && !state.queued.load(std::memory_order_relaxed)) {
+    const u64 end = Ticks() + spin;
+    do {
+      for (int i = 0; i < 4; ++i) {
+        Pause();
+      }
+      const u64 word = state.word.load(std::memory_order_relaxed);
+      if (word & (kMigrating | kHost)) {
+        break;
+      }
+      if (word & kValueMask) {
+        switch (TryTake(state, kind)) {
+          case Take::kTaken:
+            return WaitResult::kTaken;
+          case Take::kHost:
+            return WaitResult::kHost;
+          case Take::kEmpty:
+            break;
+        }
+      }
+    } while (Ticks() < end);
+  }
+
+  using clock = std::chrono::steady_clock;
+  const bool infinite = timeout == std::chrono::milliseconds::max();
+  const auto deadline = infinite ? clock::time_point::max() : clock::now() + timeout;
+  thread_local std::atomic<u32> host_park{0};
+  std::atomic<u32>& park = self ? self->GetParkWord() : host_park;
+  for (;;) {
+    FastWaiter node;
+    node.park = &park;
+    Lock(state);
+    if (state.word.load(std::memory_order_seq_cst) & kHost) {
+      Unlock(state);
+      return WaitResult::kHost;
+    }
+    // Counted before the last look at the word: a signaler that misses this look sees the count.
+    state.queued.fetch_add(1, std::memory_order_seq_cst);
+    if (TryTake(state, kind) == Take::kTaken) {
+      state.queued.fetch_sub(1, std::memory_order_seq_cst);
+      Unlock(state);
+      return WaitResult::kTaken;
+    }
+    // Clears an old signal bit, keeps an interrupt: that one ends the sleep at once.
+    park.fetch_and(kParkInterrupt, std::memory_order_seq_cst);
+    Append(state, &node);
+    Unlock(state);
+    t_last_path = 2;
+
+    // A stop or suspend request sets the thread's flags, then the park word's interrupt bit.
+    bool interrupted = self && self->HasWaitInterrupt();
+    bool timed_out = false;
+    for (;;) {
+      const u32 outcome = node.outcome.load(std::memory_order_acquire);
+      if (outcome == kGiven || outcome == kMoved || interrupted) {
+        break;
+      }
+      std::chrono::milliseconds left = std::chrono::milliseconds::max();
+      if (!infinite) {
+        left = std::chrono::ceil<std::chrono::milliseconds>(deadline - clock::now());
+        if (left.count() <= 0) {
+          timed_out = true;
+          break;
+        }
+      }
+      rex::platform::WaitOnWord(park, 0, left);
+      if (park.load(std::memory_order_seq_cst) & kParkInterrupt) {
+        interrupted = true;
+      }
+    }
+
+    Lock(state);
+    // Taking the lock also waits for a signaler that is still waking this thread.
+    const u32 outcome = node.outcome.load(std::memory_order_acquire);
+    if (outcome == kOrphaned) {
+      // No signal reaches it any more: it ends on its timeout or a stop, as on the console.
+      Unlock(state);
+      return interrupted ? WaitResult::kInterrupted : WaitResult::kTimeout;
+    }
+    if (!outcome) {
+      Unlink(state, &node);
+      // A signal that reached the word but not this thread yet.
+      const bool taken = TryTake(state, kind) == Take::kTaken;
+      Unlock(state);
+      if (taken) {
+        return WaitResult::kTaken;
+      }
+      if (interrupted) {
+        return WaitResult::kInterrupted;
+      }
+      if (timed_out) {
+        return WaitResult::kTimeout;
+      }
+      continue;
+    }
+    Unlock(state);
+    return outcome == kGiven ? WaitResult::kTaken : WaitResult::kHost;
+  }
+}
+
+bool MoveToHost(FastState& state, const std::function<void(u32 value)>& publish) {
+  if (state.word.load(std::memory_order_acquire) & kHost) {
+    return false;
+  }
+  Lock(state);
+  u64 word = state.word.load(std::memory_order_seq_cst);
+  const bool moved = !(word & kHost);
+  if (moved) {
+    // Freezes the value: lock free signals and takes wait until the host carries it.
+    while (!state.word.compare_exchange_weak(word, word | kMigrating, std::memory_order_seq_cst)) {}
+    publish(static_cast<u32>(word));
+    state.word.store(kHost, std::memory_order_seq_cst);
+    while (state.head) {
+      Satisfy(state, kMoved);
+    }
+    g_host_moves.fetch_add(1, std::memory_order_relaxed);
+  }
+  Unlock(state);
+  return moved;
+}
+
+void Reinit(FastState& state, Kind kind, u32 value, const std::function<void()>& replace_host) {
+  Lock(state);
+  replace_host();
+  if (!(state.word.load(std::memory_order_seq_cst) & kHost)) {
+    // The new header has an empty wait list: the queued threads keep sleeping, unreachable.
+    while (FastWaiter* node = state.head) {
+      Unlink(state, node);
+      node->outcome.store(kOrphaned, std::memory_order_release);
+    }
+    Store(state, value);
+    Hand(state, kind);
+  }
+  Unlock(state);
+}
+
+u64 HostMoves() {
+  return g_host_moves.load(std::memory_order_relaxed);
+}
+
+}  // namespace rex::kernel::fast
