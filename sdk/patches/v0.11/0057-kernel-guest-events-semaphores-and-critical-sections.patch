diff --git a/include/rex/kernel/object/fast_state.h b/include/rex/kernel/object/fast_state.h
new file mode 100644
index 00000000..5176be57
--- /dev/null
+++ b/include/rex/kernel/object/fast_state.h
@@ -0,0 +1,41 @@
+/**
+ * @file        kernel/object/fast_state.h
+ * @brief       User space state of a guest event or semaphore
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <atomic>
+
+#include <rex/types.h>
+
+namespace rex::kernel {
+
+struct FastWaiter;
+
+/**
+ * The signal state of an event or a semaphore, kept in user space so that a signal with no waiter
+ * and a wait on a signaled object cost no system call. A thread that must sleep queues itself here
+ * and sleeps on its own word. Waits the host must do (on several objects, alertable ones) move the
+ * object to its host primitive for good, which then carries the state as before.
+ */
+struct FastState {
+  /** The low 32 bits hold the state: 0 or 1 for an event, the count of a semaphore. */
+  static constexpr u64 kValueMask = 0xFFFFFFFFull;
+  /** Set while the state moves to the host primitive. */
+  static constexpr u64 kMigrating = 1ull << 32;
+  /** Set once the host primitive carries the state. */
+  static constexpr u64 kHost = 1ull << 33;
+
+  std::atomic<u64> word{kHost};
+  /** The number of threads queued, read without the lock by the signalers. */
+  std::atomic<u32> queued{0};
+  std::atomic<u32> lock{0};
+  FastWaiter* head = nullptr; /**< The queued threads, oldest first. */
+  FastWaiter* tail = nullptr;
+};
+
+}  // namespace rex::kernel
