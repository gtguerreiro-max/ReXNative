+REX_TEST_CASE("fast waits: a contended critical section keeps every increment",
+              "[kernel][interlocked][fast][stress]") {
+  KernelFixture fixture;
+  fixture.RunOnGuestThread([](Caller& c) {
+    constexpr int kThreads = 4;
+    constexpr int kEach = 20000;
+    const u32 section = c.Alloc(28);
+    const u32 counter = c.Alloc(4);
+    c.Store32(counter, 0);
+    c.Kernel("RtlInitializeCriticalSection", {section});
+    std::vector<u32> threads;
+    for (int i = 0; i < kThreads; ++i) {
+      threads.push_back(c.Spawn([section, counter](Caller& t) {
+        for (int n = 0; n < kEach; ++n) {
+          t.Kernel("RtlEnterCriticalSection", {section});
+          t.Store32(counter, t.Load32(counter) + 1);
+          if (n % 64 == 0) {
+            // Held for 50 us now and then, longer than a spin, so the others queue and sleep too.
+            const auto until = std::chrono::steady_clock::now() + std::chrono::microseconds(50);
+            while (std::chrono::steady_clock::now() < until) {}
+          }
+          t.Kernel("RtlLeaveCriticalSection", {section});
+        }
+      }));
+    }
+    for (u32 thread : threads) {
+      Join(c, thread);
+    }
+    CHECK(c.Load32(counter) == static_cast<u32>(kThreads * kEach));
+    CHECK(c.Kernel("RtlTryEnterCriticalSection", {section}) == 1);
+    c.Kernel("RtlLeaveCriticalSection", {section});
+  });
+}
