+#if REX_PLATFORM_LINUX || defined(__linux__)
+bool WaitOnWord(const std::atomic<u32>& word, u32 expected, std::chrono::milliseconds timeout) {
+  timespec ts{};
+  timespec* tsp = nullptr;
+  if (timeout != std::chrono::milliseconds::max()) {
+    const auto ms = std::max<i64>(timeout.count(), 0);
+    ts.tv_sec = static_cast<time_t>(ms / 1000);
+    ts.tv_nsec = static_cast<long>((ms % 1000) * 1000000);
+    tsp = &ts;
+  }
+  const long result = syscall(SYS_futex, &word, FUTEX_WAIT_PRIVATE, expected, tsp, nullptr, 0);
+  return !(result == -1 && errno == ETIMEDOUT);
+}
+
+void WakeOneOnWord(std::atomic<u32>& word) {
+  syscall(SYS_futex, &word, FUTEX_WAKE_PRIVATE, 1, nullptr, nullptr, 0);
+}
+
+void WakeAllOnWord(std::atomic<u32>& word) {
+  syscall(SYS_futex, &word, FUTEX_WAKE_PRIVATE, INT32_MAX, nullptr, nullptr, 0);
+}
+#else
+bool WaitOnWord(const std::atomic<u32>& word, u32 expected, std::chrono::milliseconds timeout) {
+  // No futex here: a short sleep, which callers treat as an early return.
+  if (word.load(std::memory_order_acquire) != expected) {
+    return true;
+  }
+  const auto step = std::min(timeout, std::chrono::milliseconds(1));
+  std::this_thread::sleep_for(step);
+  return step < timeout;
+}
+
+void WakeOneOnWord(std::atomic<u32>&) {}
+
+void WakeAllOnWord(std::atomic<u32>&) {}
+#endif
