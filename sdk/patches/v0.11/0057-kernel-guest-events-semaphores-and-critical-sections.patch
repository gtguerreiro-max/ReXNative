+/**
+ * @file        kernel/object/fast_sync.h
+ * @brief       Events and semaphores whose state lives in user space
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * Under Proton every operation on a host event or semaphore is a system call (ntsync), and a
+ * thread whose object is not signaled yet sleeps at once, to be woken a few microseconds later by
+ * another core. Recompiled titles that hand work between threads thousands of times a second pay
+ * that on every hand-off. Here the state is an atomic word: a signal with no queued waiter only
+ * changes the word, a wait first takes the word, then spins a few microseconds, and only then
+ * queues itself and sleeps on its own thread's word (WaitOnAddress, a plain futex under Wine).
+ *
+ * The semantics stay the kernel's: a signal goes to the queued waiters first, oldest first (an
+ * auto reset event or a semaphore count to one waiter each, a manual reset event to all of them),
+ * and only what is left stays in the word; a semaphore never passes its limit. A thread that spins
+ * has not started to wait yet as far as the guest can tell. Waits the host must do (on several
+ * objects, alertable ones, signal-and-wait) move the object to its host primitive for good.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <functional>
+
+#include <rex/kernel/object/fast_state.h>
+#include <rex/types.h>
+
+namespace rex::kernel {
+class KernelThread;
+}  // namespace rex::kernel
+
+namespace rex::kernel::fast {
+
+enum class Kind : u8 {
+  kManualEvent,
+  kAutoEvent,
+  kSemaphore,
+};
+
+/** True when runtime.fast_waits is on: new events, semaphores and critical sections use it. */
+bool Enabled();
+
+/** The time a wait or a critical section spins before it sleeps, in TSC ticks, 0 for none. */
+u64 SpinTicks();
+
+/** The TSC now, or a steady clock where there is none. */
+u64 Ticks();
+
+/** Ticks() per microsecond, measured once. */
+u64 TicksPerMicrosecond();
+
+/** One pause of a spin loop. */
+void Pause();
+
+/** Puts the state in user space with a value. Only for an object no other thread sees yet. */
+void Init(FastState& state, u32 value);
+
+/** True once the host primitive carries the state. */
+bool IsHost(const FastState& state);
+
+enum class Result : u8 {
+  kDone,
+  kHost,  /**< The host primitive carries the state: the caller uses it. */
+  kLimit, /**< A semaphore release that would pass the limit, which changed nothing. */
+};
+
+Result Set(FastState& state, Kind kind);
+Result Reset(FastState& state);
+/** Releases the current waiters (one for an auto reset event) and leaves the event unsignaled. */
+Result Pulse(FastState& state, Kind kind);
+
+/**
+ * @param count Above 0.
+ * @param previous Receives the count before the release, 0 when it fails.
+ */
+Result Release(FastState& state, u32 count, u32 limit, u32* previous);
+
+/**
+ * @return True with the value in *value, false when the host primitive carries the state.
+ */
+bool Read(const FastState& state, u32* value);
+
+enum class WaitResult : u8 {
+  kTaken,
+  kTimeout,
+  kInterrupted, /**< A stop or a suspend request: the caller checks them and waits again. */
+  kHost,        /**< The object moved to its host primitive: the caller waits on it. */
+};
+
+/**
+ * Takes one signal of the object: the event's (an auto reset event resets), or one count.
+ *
+ * @param timeout 0 to poll, milliseconds::max() for no limit.
+ * @param self The calling thread, whose stop and suspend requests end the wait. Null on a host
+ * thread without one, which sleeps on a word of its own.
+ */
+WaitResult Wait(FastState& state, Kind kind, std::chrono::milliseconds timeout, KernelThread* self);
+
+/** How the calling thread's latest Wait ended: 0 at once, 1 after a spin, 2 after a sleep. */
+u8 LastPath();
+
+/**
+ * Moves the state to the host primitive, for good. The queued threads wake and wait on the host.
+ *
+ * @param publish Called once, under the lock, with the value the host primitive must take.
+ * @return True when this call moved it.
+ */
+bool MoveToHost(FastState& state, const std::function<void(u32 value)>& publish);
+
+/**
+ * Gives the object a new value, as a guest initializer does. The queued threads stay asleep out of
+ * reach, as the kernel's new empty wait list leaves them.
+ *
+ * @param replace_host Called under the lock: replaces the host primitive, which carries the new
+ * state when the object is on the host already.
+ */
+void Reinit(FastState& state, Kind kind, u32 value, const std::function<void()>& replace_host);
+
+/** Counts objects that moved to the host since the start, for the wait stats. */
+u64 HostMoves();
+
+}  // namespace rex::kernel::fast
