new file mode 100644
index 00000000..685434ad
--- /dev/null
+++ b/src/kernel/wait_stats.h
@@ -0,0 +1,107 @@
+/**
+ * @file        kernel/wait_stats.h
+ * @brief       Counts of guest waits per kind and per thread, logged every few seconds
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <chrono>
+
+#include <rex/types.h>
+
+namespace rex::kernel::wait_stats {
+
+/** What a guest thread waited on. */
+enum class Kind : u8 {
+  kCriticalSection, /**< RtlEnterCriticalSection that found the section owned. */
+  kEvent,
+  kSemaphore,
+  kMutant,
+  kTimer,
+  kThread,
+  kOther,      /**< Any other single object. */
+  kMultiAny,   /**< A wait on any of several events and semaphores. */
+  kMultiOther, /**< A wait on all of several objects, or on any with another type among them. */
+  kSignalWait, /**< NtSignalAndWaitForSingleObjectEx. */
+  kDelay,      /**< KeDelayExecutionThread with a nonzero interval. */
+  kYield,      /**< KeDelayExecutionThread with a zero interval, and NtYieldExecution. */
+  kCount,
+};
+
+/** What a guest thread signaled. */
+enum class Signal : u8 {
+  kEvent,           /**< Set or pulse of an event. */
+  kSemaphore,       /**< Release of a semaphore. */
+  kCriticalSection, /**< RtlLeaveCriticalSection that handed the section to a waiter. */
+  kCount,
+};
+
+/** How a wait ended. */
+enum class Path : u8 {
+  kImmediate, /**< Satisfied by the first check, in user space. */
+  kSpun,      /**< Satisfied while the host spun. */
+  kSlept,     /**< Satisfied after a sleep on the thread's park word. */
+  kHostQuick, /**< A wait on a host primitive that took 5 us or less. */
+  kHostLong,  /**< A wait on a host primitive that took longer: it slept. */
+  kCount,
+};
+
+/** True when runtime.wait_stats is on. */
+bool Enabled();
+
+/**
+ * Records one wait of the calling thread.
+ *
+ * @param took The time the wait took.
+ * @param path How it ended, kBlocked when the caller cannot tell.
+ */
+void RecordWait(Kind kind, std::chrono::nanoseconds took, Path path, bool alertable);
+
+/** Notes how the calling thread's latest wait ended, for an outer wait that records it. */
+void NotePath(Path path);
+
+/** Returns how the calling thread's latest wait ended, then forgets it. kCount for none. */
+Path TakePath();
+
+/** Records one signal of the calling thread. */
+void RecordSignal(Signal signal);
+
+/** Times a wait from its construction to its destruction, when the counts are on. */
+class Timer {
+ public:
+  explicit Timer(Kind kind, bool alertable = false);
+  ~Timer();
+
+  Timer(const Timer&) = delete;
+  Timer& operator=(const Timer&) = delete;
+
+  /** Sets how the wait ended. Without a call it counts as a host wait, quick or long by its time.
+   */
+  void SetPath(Path path) { path_ = path; }
+  void SetKind(Kind kind) { kind_ = kind; }
+
+ private:
+  std::chrono::steady_clock::time_point start_;
+  Kind kind_;
+  Path path_ = Path::kCount;
+  bool alertable_;
+  bool on_;
+};
+
+/** While alive, waits of the calling thread are not recorded: an outer wait records them. */
+class Suppress {
+ public:
+  Suppress();
+  ~Suppress();
+
+  Suppress(const Suppress&) = delete;
+  Suppress& operator=(const Suppress&) = delete;
+
+  /** True while a Suppress of the calling thread is alive. */
+  static bool Active();
+};
+
+}  // namespace rex::kernel::wait_stats
