diff --git a/include/rex/hid/input_system.h b/include/rex/hid/input_system.h
index 9aef69e2..cf364e78 100644
--- a/include/rex/hid/input_system.h
+++ b/include/rex/hid/input_system.h
@@ -251,6 +251,13 @@ REX_DECLARE_INTERFACE(IInputSystem, 2)
    * @return The text ParseInputSource reads back, or empty when the source names nothing.
    */
   [[nodiscard]] virtual std::string InputSourceToString(const InputSource& source) const = 0;
+
+  /**
+   * Reads a user's pad as GetState does, but also while the title's input is blocked: the
+   * system dialogs (AcquireUIBlock's) are answered with it. Last in the table, so code built
+   * against the interface before it keeps its slots.
+   */
+  [[nodiscard]] virtual Result<PadReading> GetStateForUI(u32 user) = 0;
 };
 
 }  // namespace rex::hid
diff --git a/src/hid/input_system.cpp b/src/hid/input_system.cpp
index 5ec15f95..542e17cc 100644
--- a/src/hid/input_system.cpp
+++ b/src/hid/input_system.cpp
@@ -385,6 +385,25 @@ Result<InputSystem::PadReading> InputSystem::GetState(u32 user) {
   return result;
 }
 
+Result<InputSystem::PadReading> InputSystem::GetStateForUI(u32 user) {
+  State& state = *state_;
+  std::vector<ConnectionEvent> events;
+  Result<PadReading> result = std::unexpected(NotFound("input is not started"));
+  {
+    std::lock_guard lock(state.mutex);
+    if (state.started) {
+      state.RefreshDevicesLocked(events);
+      if (auto raw = state.ReadRawLocked(user)) {
+        result = PadReading{.packet = 0, .state = *raw};
+      } else {
+        result = std::unexpected(raw.error());
+      }
+    }
+  }
+  state.Fire(events);
+  return result;
+}
+
 Result<rex::hid::PadCapabilities> InputSystem::GetCapabilities(u32 user) {
   State& state = *state_;
   std::vector<ConnectionEvent> events;
