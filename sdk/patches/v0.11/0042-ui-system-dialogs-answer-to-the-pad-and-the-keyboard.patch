   void SetDisplay(u32 physical_width, u32 physical_height, f32 content_scale);
+  /**
+   * The pad (XInput button bits and sticks) for the dialogs' gamepad navigation, each frame a
+   * dialog is drawn. `first`: the dialogs' first frame, whose held buttons are ignored until
+   * released (the press that opened a dialog does not answer it).
+   */
+  void SetPad(u16 buttons, i16 thumb_lx, i16 thumb_ly, bool first);
   bool HandleEvent(UIEvent& event);
   void HandleEvent(InputEvent& event);
   ImDrawData* BuildFrame();
@@ -94,6 +100,8 @@ class ImGuiHost final {
   u32 touch_pointer_id_ = TouchEvent::kPointerIDNone;
   bool reset_mouse_position_after_next_frame_ = false;
   bool text_input_active_ = false;
+  u16 pad_buttons_ = 0;  // SetPad's last, after the ignored ones
+  u16 pad_ignored_ = 0;  // held when the dialogs appeared, until released
   bool changed_ = false;
   u32 display_width_ = 0;
   u32 display_height_ = 0;
diff --git a/src/ui/prompt.cpp b/src/ui/prompt.cpp
index a1e58db4..e6c31249 100644
--- a/src/ui/prompt.cpp
+++ b/src/ui/prompt.cpp
@@ -52,6 +52,13 @@ std::string PromptDialog::GetText() const {
 }
 
 void PromptDialog::DrawButtons() {
+  // B or Escape: the last button, the escape one (dialog.h).
+  if (ImGui::IsKeyPressed(ImGuiKey_GamepadFaceRight, false) ||
+      ImGui::IsKeyPressed(ImGuiKey_Escape, false)) {
+    ImGui::CloseCurrentPopup();
+    Choose(static_cast<u32>(buttons_.size() - 1), {});
+    return;
+  }
   for (size_t index = 0; index < buttons_.size(); ++index) {
     if (index != 0) {
       ImGui::SameLine();
@@ -65,6 +72,12 @@ void PromptDialog::DrawButtons() {
 }
 
 void PromptDialog::DrawInput() {
+  if (ImGui::IsKeyPressed(ImGuiKey_GamepadFaceRight, false)) {
+    ImGui::CloseCurrentPopup();
+    Complete({});
+    closing_ = true;
+    return;
+  }
   const bool entered = ImGui::InputText("##body", buffer_.data(), buffer_.size(),
                                         ImGuiInputTextFlags_EnterReturnsTrue);
   bool accepted = entered;
@@ -102,10 +115,16 @@ bool PromptDialog::Draw(ImGuiIO& io) {
     return false;
   }
   if (!config_.body.empty()) {
-    ImGui::TextWrapped("%s", config_.body.c_str());
+    // Wrapped at 32 characters' width, not the window's: an auto-sized window takes its width
+    // from its content, so a message box with two short buttons wrapped its text after every
+    // word (Asura's Wrath's "saved data does not exist" on the Steam Deck).
+    ImGui::PushTextWrapPos(ImGui::GetCursorPosX() + ImGui::GetFontSize() * 32.0f);
+    ImGui::TextUnformatted(config_.body.c_str());
+    ImGui::PopTextWrapPos();
   }
   if (first_draw) {
     ImGui::SetKeyboardFocusHere();
+    ImGui::SetNavCursorVisible(true);  // the default button shows as selected
   }
   if (config_.text_input) {
     DrawInput();
