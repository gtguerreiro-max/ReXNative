From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: gtguerreiro-max <295622337+gtguerreiro-max@users.noreply.github.com>
Date: Mon, 16 Nov 2026 17:21:44 +0000
Subject: [PATCH 19/20] 
 0008-gpu-publish-the-guest-gamma-ramps-for-a-host-renderer

---
 include/rex/xenos/draw_hook.h       | 14 ++++++++++++++
 src/base/draw_hook.cpp              | 15 +++++++++++++++
 src/gpu/xenos/command_processor.cpp |  7 +++++++
 3 files changed, 36 insertions(+)

diff --git a/include/rex/xenos/draw_hook.h b/include/rex/xenos/draw_hook.h
index 45258528..45a54db7 100644
--- a/include/rex/xenos/draw_hook.h
+++ b/include/rex/xenos/draw_hook.h
@@ -28,4 +28,18 @@ using PixelConstantHook = bool (*)(u64 pixel_shader_ucode_hash, const u64* used_
 REX_API void SetPixelConstantHook(PixelConstantHook hook);
 REX_API PixelConstantHook GetPixelConstantHook();
 
+/**
+ * The guest's gamma ramps as the Xenos command processor holds them, for a host renderer that
+ * presents the title itself: the 256 entry table (DC_LUT_30_COLOR words, 10:10:10) and the PWL
+ * ramp (128 entries of 3 DC_LUT_PWL_DATA words, base 16 and delta 16 bits). The command
+ * processor's thread writes them as it executes the guest's register writes. Null while no
+ * command processor runs.
+ */
+struct GammaRampView {
+  const u32* table_256 = nullptr;
+  const u32* pwl_rgb = nullptr;
+};
+REX_API void SetGammaRampView(const GammaRampView& view);
+REX_API GammaRampView GetGammaRampView();
+
 }  // namespace rex::xenos
diff --git a/src/base/draw_hook.cpp b/src/base/draw_hook.cpp
index 3fe8b1b0..cbda132f 100644
--- a/src/base/draw_hook.cpp
+++ b/src/base/draw_hook.cpp
@@ -21,4 +21,19 @@ PixelConstantHook GetPixelConstantHook() {
   return g_pixel_constant_hook.load(std::memory_order_acquire);
 }
 
+namespace {
+std::atomic<const u32*> g_gamma_table_256{nullptr};
+std::atomic<const u32*> g_gamma_pwl_rgb{nullptr};
+}  // namespace
+
+void SetGammaRampView(const GammaRampView& view) {
+  g_gamma_table_256.store(view.table_256, std::memory_order_release);
+  g_gamma_pwl_rgb.store(view.pwl_rgb, std::memory_order_release);
+}
+
+GammaRampView GetGammaRampView() {
+  return {g_gamma_table_256.load(std::memory_order_acquire),
+          g_gamma_pwl_rgb.load(std::memory_order_acquire)};
+}
+
 }  // namespace rex::xenos
diff --git a/src/gpu/xenos/command_processor.cpp b/src/gpu/xenos/command_processor.cpp
index a0c41c08..2bfadf23 100644
--- a/src/gpu/xenos/command_processor.cpp
+++ b/src/gpu/xenos/command_processor.cpp
@@ -26,6 +26,7 @@
 #include "gpu/xenos/command_processor.h"
 #include "gpu/xenos/xenos_graphics_driver_base.h"
 #include "gpu/xenos/physical_memory.h"
+#include <rex/xenos/draw_hook.h>
 #include <rex/xenos/texture.h>
 #include "gpu/xenos/sampler_info.h"
 #include <rex/xenos/fetch.h>
@@ -112,6 +113,11 @@ bool CommandProcessor::Initialize() {
       gamma_ramp_pwl_rgb_[i][j] = gamma_ramp_entry;
     }
   }
+  static_assert(sizeof(gamma_ramp_256_entry_table_[0]) == sizeof(u32) &&
+                sizeof(gamma_ramp_pwl_rgb_[0][0]) == sizeof(u32));
+  rex::xenos::SetGammaRampView(
+      {reinterpret_cast<const u32*>(gamma_ramp_256_entry_table_),
+       reinterpret_cast<const u32*>(gamma_ramp_pwl_rgb_)});
 
   worker_running_ = true;
   auto thread = guest_interrupts_.StartHostThread("GPU Commands", [this](const std::stop_token&) {
@@ -128,6 +134,7 @@ bool CommandProcessor::Initialize() {
 }
 
 void CommandProcessor::Shutdown() {
+  rex::xenos::SetGammaRampView({});
   worker_running_ = false;
   write_ptr_index_event_->Set();
   worker_thread_ = ScopeGuard();
